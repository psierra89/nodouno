{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nodouno/calc": ["../../packages/calc/src/index.ts"],
      "@nodouno/calc/*": ["../../packages/calc/src/*"],
      "@nodouno/editor2d": ["../../packages/editor2d/src/index.ts"],
      "@nodouno/editor2d/*": ["../../packages/editor2d/src/*"],
      "@nodouno/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"]
}
