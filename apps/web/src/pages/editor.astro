---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IconButton from '../components/IconButton.astro';
---
<Layout title="Nodouno · Editor 2D">
  <main class="min-h-screen bg-paper text-obsidian">
    <header class="flex flex-wrap items-center justify-between gap-16 border-b border-line bg-canvas-white px-23 py-13">
      <div class="flex items-center gap-13">
        <span class="microlabel">Nodouno · Editor 2D</span>
        <span class="h-[20px] w-px bg-line" aria-hidden="true"></span>
        <span id="active-project-label" class="font-display text-subheading leading-subheading font-semibold">Sin proyecto activo</span>
      </div>
      <div class="flex flex-wrap items-center gap-11">
        <span id="session-label" class="hidden text-slate-mist md:inline">Comprobando sesion...</span>
        <IconButton id="go-dashboard-btn" variant="ghost" href="/dashboard" icon="layout-dashboard" label="Ir al dashboard" />
        <IconButton id="logout-btn" variant="dark" icon="log-out" label="Cerrar sesion" />
      </div>
    </header>

    <nav class="flex flex-wrap items-center justify-between gap-11 border-b border-line bg-canvas-white px-23 py-11">
      <div class="flex flex-wrap gap-8" role="tablist" aria-label="Fases del proyecto">
        <button
          type="button"
          data-step-pill="1"
          class="cad-step-pill"
          title="Paso 1: Especificaciones"
          aria-label="Paso 1: Especificaciones"
        >
          <span class="cad-step-num">01</span>
          <Icon name="settings" size={16} />
          <span class="cad-step-text">Especificaciones</span>
        </button>
        <button
          type="button"
          data-step-pill="2"
          class="cad-step-pill"
          title="Paso 2: Dibujo 2D"
          aria-label="Paso 2: Dibujo 2D"
        >
          <span class="cad-step-num">02</span>
          <Icon name="pencil-ruler" size={16} />
          <span class="cad-step-text">Dibujo 2D</span>
        </button>
        <button
          type="button"
          data-step-pill="3"
          class="cad-step-pill"
          title="Paso 3: Cargas"
          aria-label="Paso 3: Cargas"
        >
          <span class="cad-step-num">03</span>
          <Icon name="weight" size={16} />
          <span class="cad-step-text">Cargas</span>
        </button>
        <button
          type="button"
          data-step-pill="4"
          class="cad-step-pill"
          title="Paso 4: Calculo"
          aria-label="Paso 4: Calculo"
        >
          <span class="cad-step-num">04</span>
          <Icon name="calculator" size={16} />
          <span class="cad-step-text">Cálculo</span>
        </button>
      </div>
      <div class="flex gap-8">
        <IconButton id="prev-step-btn" variant="ghost" icon="chevron-left" label="Paso anterior" />
        <IconButton id="next-step-btn" variant="dark" icon="chevron-right" label="Paso siguiente" />
      </div>
    </nav>

    <section id="step-panel-1" data-step-panel="1" class="px-23 py-38">
      <div class="panel mx-auto w-full max-w-[900px] p-31">
        <p class="microlabel">Paso 01</p>
        <h3 class="mt-8 font-display text-heading-sm leading-heading-sm tracking-heading-sm font-semibold">Especificaciones de proyecto</h3>
        <p class="mt-11 max-w-[62ch] text-slate-mist">
          Reglamento fijo por ahora: CIRSOC 201. Acero fijo: ADN420. Hormigón seleccionable.
        </p>
        <div class="mt-23 grid gap-16 border-t border-line pt-23 sm:grid-cols-3">
          <label class="flex flex-col gap-8">
            <span class="microlabel text-obsidian">Reglamento</span>
            <select id="spec-regulation" class="cad-input">
              <option value="CIRSOC_201">CIRSOC 201</option>
            </select>
          </label>
          <label class="flex flex-col gap-8">
            <span class="microlabel text-obsidian">Acero</span>
            <select id="spec-steel" class="cad-input">
              <option value="ADN_420">ADN420</option>
            </select>
          </label>
          <label class="flex flex-col gap-8">
            <span class="microlabel text-obsidian">Hormigón</span>
            <select id="spec-concrete" class="cad-input">
              <option value="H25">H25</option>
              <option value="H30">H30</option>
              <option value="H35">H35</option>
            </select>
          </label>
        </div>
        <p id="specs-status" class="mt-16 text-body-sm text-slate-mist" role="status" aria-live="polite">
          Cargando...
        </p>
      </div>
    </section>

    <section id="step-panel-2" data-step-panel="2" class="hidden flex">
      <div id="cad-shell" class="relative grid w-full" style="grid-template-columns: 56px minmax(0, 1fr) 320px; min-height: calc(100vh - 120px);">
        <aside class="flex flex-col items-center gap-8 border-r border-line bg-canvas-white py-13" aria-label="Herramientas">
          <button type="button" data-tool="select" class="cad-tool" title="Seleccionar (V)" aria-label="Seleccionar">
            <Icon name="mouse-pointer" size={18} />
          </button>
          <button type="button" data-tool="pan" class="cad-tool" title="Pan (H, espacio)" aria-label="Pan">
            <Icon name="hand" size={18} />
          </button>
          <div class="my-4 h-px w-[28px] bg-line"></div>
          <button type="button" data-tool="beam" class="cad-tool" title="Viga / Linea (L)" aria-label="Viga">
            <Icon name="line-diagonal" size={18} />
          </button>
          <button type="button" data-tool="column" class="cad-tool" title="Columna / Rectangulo (R)" aria-label="Columna">
            <Icon name="square" size={18} />
          </button>
          <button type="button" data-tool="slab" class="cad-tool" title="Losa / Poligono (P)" aria-label="Losa">
            <Icon name="pentagon" size={18} />
          </button>
          <div class="my-4 h-px w-[28px] bg-line"></div>
          <button type="button" id="cad-undo" class="cad-tool" title="Deshacer (Ctrl+Z)" aria-label="Deshacer">
            <Icon name="undo" size={18} />
          </button>
          <button type="button" id="cad-redo" class="cad-tool" title="Rehacer (Ctrl+Shift+Z)" aria-label="Rehacer">
            <Icon name="redo" size={18} />
          </button>
          <button type="button" id="cad-delete" class="cad-tool" title="Eliminar (Supr)" aria-label="Eliminar">
            <Icon name="trash" size={18} />
          </button>
          <button type="button" id="cad-fit" class="cad-tool" title="Encajar (Shift+0)" aria-label="Encajar vista">
            <Icon name="maximize" size={18} />
          </button>
          <button type="button" id="cad-help-toggle" class="cad-tool mt-auto" title="Atajos" aria-label="Mostrar atajos">
            <Icon name="help-circle" size={18} />
          </button>
        </aside>

        <div class="relative bg-canvas-white">
          <canvas
            id="cad-canvas"
            tabindex="0"
            class="absolute inset-0 block h-full w-full outline-none"
          ></canvas>
          <div id="cad-hud-top" class="pointer-events-none absolute left-16 right-16 top-13 flex flex-wrap items-center gap-8">
            <span id="hud-tool" class="cad-chip cad-chip-strong">Select</span>
            <span id="hud-snap" class="cad-chip">Snap: ON</span>
            <span id="hud-ortho" class="cad-chip">Ortho: OFF</span>
            <span id="hud-snap-kind" class="cad-chip cad-chip-accent hidden">snap</span>
            <span id="hud-status" class="cad-chip cad-chip-muted">Listo.</span>
          </div>
          <div id="cad-hud-bottom" class="pointer-events-none absolute left-16 right-16 bottom-13 flex flex-wrap items-center justify-between gap-8">
            <div class="pointer-events-auto flex flex-wrap items-center gap-8">
              <span id="hud-coords" class="cad-chip cad-chip-strong">x: 0.000 m · y: 0.000 m</span>
              <span id="hud-zoom" class="cad-chip">Escala: 80 px/m</span>
              <span id="hud-measure" class="cad-chip cad-chip-accent hidden">—</span>
            </div>
            <div class="pointer-events-auto flex flex-wrap items-center gap-8">
              <IconButton id="cad-zoom-out" variant="ghost" size="sm" icon="zoom-out" label="Alejar" />
              <IconButton id="cad-zoom-in" variant="ghost" size="sm" icon="zoom-in" label="Acercar" />
              <IconButton id="cad-reset-view" variant="ghost" size="sm" icon="maximize" label="Restablecer vista" />
            </div>
          </div>
          <div id="cad-help-panel" class="panel pointer-events-auto absolute right-16 top-59 hidden max-w-[320px] p-21 text-body-sm shadow-[0_12px_32px_rgba(13,27,38,0.12)]">
            <h4 class="microlabel text-obsidian">Atajos de teclado</h4>
            <ul class="mt-13 grid gap-8 text-slate-mist">
              <li><strong class="text-obsidian">V</strong> Seleccionar</li>
              <li><strong class="text-obsidian">H</strong> / Espacio · Pan</li>
              <li><strong class="text-obsidian">L</strong> Viga</li>
              <li><strong class="text-obsidian">R</strong> Columna</li>
              <li><strong class="text-obsidian">P</strong> Losa (poligono)</li>
              <li><strong class="text-obsidian">Supr</strong> Eliminar seleccion</li>
              <li><strong class="text-obsidian">F8</strong> Toggle ortho</li>
              <li><strong class="text-obsidian">F9</strong> Toggle snap</li>
              <li><strong class="text-obsidian">Ctrl+Z</strong> / <strong class="text-obsidian">Ctrl+Shift+Z</strong> Undo / Redo</li>
              <li><strong class="text-obsidian">Ctrl+A</strong> Seleccionar todo</li>
              <li><strong class="text-obsidian">Esc</strong> Cancelar dibujo / seleccion</li>
              <li><strong class="text-obsidian">Rueda</strong> Zoom centrado en cursor</li>
              <li><strong class="text-obsidian">+/−</strong> Zoom in / out</li>
              <li><strong class="text-obsidian">0</strong> Reset vista · <strong class="text-obsidian">Shift+0</strong> Encajar</li>
            </ul>
          </div>
        </div>

        <aside class="flex flex-col gap-13 overflow-y-auto border-l border-line bg-canvas-white p-21" aria-label="Propiedades">
          <div class="border-b border-line pb-13">
            <h4 class="microlabel text-obsidian">Propiedades</h4>
            <p id="cad-selection-summary" class="mt-8 text-slate-mist">Sin seleccion.</p>
          </div>

          <fieldset id="prop-defaults-column" class="hidden grid gap-11 rounded-[6px] border border-line p-15" data-prop-group="defaults-column">
            <legend class="microlabel px-4">Columna</legend>
            <label class="grid gap-8">
              <span class="text-body-sm font-semibold">Ancho (m)</span>
              <input id="prop-default-col-w" type="number" min="0.05" step="0.05" value="0.35" class="cad-input" />
            </label>
            <label class="grid gap-8">
              <span class="text-body-sm font-semibold">Alto (m)</span>
              <input id="prop-default-col-d" type="number" min="0.05" step="0.05" value="0.35" class="cad-input" />
            </label>
          </fieldset>

          <fieldset id="prop-defaults-beam" class="hidden grid gap-11 rounded-[6px] border border-line p-15" data-prop-group="defaults-beam">
            <legend class="microlabel px-4">Viga</legend>
            <label class="grid gap-8">
              <span class="text-body-sm font-semibold">Ancho (m)</span>
              <input id="prop-default-beam-w" type="number" min="0.05" step="0.05" value="0.25" class="cad-input" />
            </label>
            <label class="grid gap-8">
              <span class="text-body-sm font-semibold">Canto (m)</span>
              <input id="prop-default-beam-d" type="number" min="0.05" step="0.05" value="0.5" class="cad-input" />
            </label>
          </fieldset>

          <fieldset id="prop-defaults-slab" class="hidden grid gap-11 rounded-[6px] border border-line p-15" data-prop-group="defaults-slab">
            <legend class="microlabel px-4">Losa</legend>
            <label class="grid gap-8">
              <span class="text-body-sm font-semibold">Espesor (m)</span>
              <input id="prop-default-slab-t" type="number" min="0.05" step="0.01" value="0.2" class="cad-input" />
            </label>
          </fieldset>

          <fieldset id="prop-selection" class="hidden grid gap-11 rounded-[6px] border border-blueprint bg-blueprint/[0.03] p-15" data-prop-group="selection">
            <legend class="microlabel px-4" style="color: var(--color-blueprint);">Seleccion</legend>
            <div id="prop-selection-fields" class="grid gap-11"></div>
          </fieldset>

          <div class="mt-auto grid gap-8 border-t border-line pt-13">
            <IconButton id="save-drawing-btn" variant="primary" icon="save" label="Guardar dibujo" />
            <IconButton id="clear-drawing-btn" variant="ghost" icon="eraser" label="Limpiar dibujo" />
          </div>
        </aside>
      </div>
    </section>

    <section id="step-panel-3" data-step-panel="3" class="hidden flex flex-col" style="min-height: calc(100vh - 120px);">
      <div
        id="loads-shell"
        class="grid min-h-0 flex-1"
        style="grid-template-columns: minmax(0, 1fr) 320px;"
      >
        <div class="relative min-h-[360px] bg-canvas-white">
          <canvas
            id="loads-canvas"
            tabindex="0"
            class="absolute inset-0 block h-full w-full outline-none"
            aria-label="Planta: seleccionar losas para cargas"
          ></canvas>
          <div class="pointer-events-none absolute left-16 right-16 bottom-13 flex flex-wrap items-center justify-end gap-8">
            <span id="loads-hud-status" class="cad-chip cad-chip-muted pointer-events-none">
              Seleccione una losa.
            </span>
            <div class="pointer-events-auto flex flex-wrap items-center gap-8">
              <IconButton id="loads-fit" variant="ghost" size="sm" icon="maximize" label="Encajar vista" />
              <IconButton id="loads-zoom-in" variant="ghost" size="sm" icon="zoom-in" label="Acercar" />
              <IconButton id="loads-zoom-out" variant="ghost" size="sm" icon="zoom-out" label="Alejar" />
            </div>
          </div>
        </div>
        <aside class="flex flex-col gap-13 overflow-y-auto border-l border-line bg-canvas-white p-21" aria-label="Cargas por losa">
          <div class="border-b border-line pb-13">
            <p class="microlabel">Paso 03</p>
            <h3 class="mt-4 font-display text-subheading leading-subheading font-semibold">Cargas por losa</h3>
            <p class="mt-8 text-slate-mist">
              Seleccione una losa en planta o en la lista. Solo se asignan cargas (CIRSOC 101); el cálculo estructural se ejecuta en el paso 4.
            </p>
          </div>
          <p id="step3-validation" class="hidden rounded-[6px] border border-desert-sienna bg-desert-sienna/10 px-15 py-13 text-body-sm text-desert-sienna" role="alert"></p>
          <p id="step3-no-slabs" class="hidden text-slate-mist">
            No hay losas en el dibujo. Vuelva al paso 2 y dibuje al menos una losa.
          </p>
          <div id="step3-loads-panel" class="hidden grid gap-13">
            <label class="grid gap-8">
              <span class="microlabel text-obsidian">Losa</span>
              <select id="step3-slab-picker" class="cad-input"></select>
            </label>
            <div id="step3-load-fields" class="grid gap-13"></div>
            <p id="step3-load-preview" class="datum text-[13px] text-slate-mist"></p>
          </div>
          <p class="mt-auto rounded-[6px] border border-line bg-paper px-15 py-13 text-body-sm text-slate-mist">
            El modelo estructural se prepara automaticamente al avanzar al paso 4.
          </p>
        </aside>
      </div>
    </section>

    <section id="step-panel-4" data-step-panel="4" class="hidden flex flex-col" style="min-height: calc(100vh - 120px);">
      <div
        id="step4-shell"
        class="grid min-h-0 flex-1"
        style="grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);"
      >
        <div class="flex min-h-[360px] flex-col gap-16 border-r border-line bg-paper p-23">
          <div>
            <p class="microlabel">Paso 04</p>
            <h3 class="mt-4 font-display text-subheading leading-subheading font-semibold">Cálculo y dimensionamiento</h3>
            <p class="mt-8 text-slate-mist">
              Ejecuta el cálculo y revisa resultados técnicos por elemento seleccionado.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-13">
            <IconButton id="run-calc-btn" variant="primary" icon="calculator" label="Calcular" />
            <p id="step4-calc-status" class="text-body-sm text-slate-mist">Pendiente de calculo.</p>
          </div>
          <div
            id="model-3d-container"
            class="panel relative w-full overflow-hidden"
            style="height: min(45vh, 420px); min-height: 280px;"
          ></div>
        </div>
        <aside class="flex flex-col gap-13 overflow-y-auto border-l border-line bg-canvas-white p-21" aria-label="Panel tecnico">
          <h4 class="microlabel border-b border-line pb-13 text-obsidian">Panel técnico</h4>
          <div
            id="step4-tech-panel"
            class="min-h-[220px] rounded-[6px] border border-line bg-canvas-white p-15 text-body-sm text-slate-mist"
          >
            Seleccione un elemento en la vista para mostrar el detalle tecnico.
          </div>
          <section class="grid gap-11 rounded-[6px] border border-line p-15">
            <div class="flex flex-wrap items-center justify-between gap-11">
              <h5 class="microlabel">Revisiones</h5>
              <IconButton id="create-revision-btn" variant="ghost" size="sm" icon="save" label="Crear snapshot" />
            </div>
            <input
              id="revision-comment-input"
              type="text"
              maxlength="120"
              placeholder="Comentario opcional del snapshot"
              class="cad-input"
            />
            <p id="revisions-status" class="text-body-sm text-slate-mist">Sincronizando revisiones...</p>
            <div id="revisions-list" class="grid gap-8 text-body-sm text-slate-mist">
              <p>No hay revisiones cargadas.</p>
            </div>
          </section>
          <section class="grid gap-11 rounded-[6px] border border-line p-15">
            <div class="flex flex-wrap items-center justify-between gap-11">
              <h5 class="microlabel">Exportación</h5>
              <div class="flex flex-wrap items-center gap-8">
                <IconButton id="export-json-btn" variant="ghost" size="sm" icon="download" label="Exportar JSON" />
                <IconButton id="export-pdf-btn" variant="ghost" size="sm" icon="save" label="Exportar PDF" />
              </div>
            </div>
            <p id="export-status" class="text-body-sm text-slate-mist">
              Exporta JSON o un informe PDF (API) del snapshot actual o de una revisión.
            </p>
          </section>
        </aside>
      </div>
    </section>

    <p id="editor-status" class="datum border-t border-line bg-canvas-white px-23 py-11 text-[12px] text-slate-mist" role="status" aria-live="polite">
      Selecciona herramienta para dibujar en planta.
    </p>
  </main>

  <style is:global>
    .cad-tool {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--color-obsidian);
      transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
      cursor: pointer;
    }
    .cad-tool:hover { border-color: var(--color-line-strong); background: var(--color-paper); }
    .cad-tool:disabled { opacity: 0.35; cursor: not-allowed; }
    .cad-tool[aria-pressed="true"] { background: var(--color-obsidian); border-color: var(--color-obsidian); color: #ffffff; }
    .cad-tool[data-tool][aria-pressed="true"] { background: var(--color-blueprint); border-color: var(--color-blueprint); color: #ffffff; }

    .cad-input {
      border-radius: 6px;
      border: 1px solid var(--color-line-strong);
      padding: 9px 12px;
      font: 500 14px/1.2 var(--font-sans);
      background: #ffffff;
      color: var(--color-obsidian);
      transition: border-color 120ms ease;
    }
    .cad-input:focus { outline: none; border-color: var(--color-blueprint); box-shadow: 0 0 0 2px rgba(28, 77, 139, 0.18); }

    /* Chips del HUD sobre el lienzo: lectura técnica en monoespaciada. */
    .cad-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 6px;
      border: 1px solid var(--color-line);
      background: rgba(255, 255, 255, 0.94);
      padding: 6px 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      color: var(--color-obsidian);
      box-shadow: 0 1px 3px rgba(13, 27, 38, 0.06);
    }
    .cad-chip.hidden { display: none; }
    .cad-chip-strong { border-color: var(--color-obsidian); font-weight: 600; }
    .cad-chip-muted { color: var(--color-slate-mist); }
    .cad-chip-accent { border-color: var(--color-blueprint); color: var(--color-blueprint); }

    /* Pestañas de fases del flujo. */
    .cad-step-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 38px;
      padding: 0 14px;
      border-radius: 6px;
      border: 1px solid var(--color-line);
      background: transparent;
      color: var(--color-slate-mist);
      font: 600 13px/1 var(--font-sans);
      transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
      cursor: pointer;
    }
    .cad-step-pill .cad-step-num {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }
    .cad-step-pill:hover { border-color: var(--color-line-strong); color: var(--color-obsidian); }
    .cad-step-pill[aria-selected="true"] {
      background: var(--color-blueprint);
      border-color: var(--color-blueprint);
      color: #ffffff;
    }
    @media (max-width: 1279px) {
      .cad-step-pill .cad-step-text { display: none; }
    }

    #cad-canvas { touch-action: none; cursor: default; }
    @media (max-width: 1023px) {
      #cad-shell { grid-template-columns: 56px minmax(0, 1fr); }
      #cad-shell aside[aria-label="Propiedades"] { display: none; }
      #loads-shell { grid-template-columns: minmax(0, 1fr); }
      #loads-shell aside[aria-label="Cargas por losa"] { max-height: 40vh; border-left: none; border-top: 1px solid var(--color-line); }
      #step4-shell { grid-template-columns: minmax(0, 1fr); }
      #step4-shell > div { border-right: none; border-bottom: 1px solid var(--color-line); }
    }
    #loads-canvas { touch-action: none; cursor: default; }
    .tech-diagram svg { display: block; }
    .tech-panel header + dl { margin-top: 0; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    import { createStructuralViewer3d } from '../lib/structuralViewer3d';
    import { hydratePipelineResults } from '../lib/editorCalcPipeline';
    import { initEditorLoadsStep } from '../lib/editorLoadsStep';
    import { downloadTechnicalReportPdf } from '../lib/editorPdfExport';
    import { initEditorRevisionsPanel } from '../lib/editorRevisionsPanel';
    import { renderTechnicalPanel, type CalcPipelineResults } from '../lib/technicalPanel';
    import {
      downloadBase64File,
      exportProjectJson,
      exportProjectPdf,
      getProject,
      listCatalogs,
      requireSession,
      runServerCalc,
      updateProject,
      type ProjectDetail
    } from '../lib/projectApi';
    import {
      calculateDemands,
      calculateDesign,
      calculateLoads,
      normalizeBuildingInput
    } from '@nodouno/calc';
    import type { BuildingInput, ElementType } from '@nodouno/calc';
    import { mountEditor2d } from '@nodouno/editor2d';
    import type { DrawingState, Editor2DHandle, HudInfo, ToolKind } from '@nodouno/editor2d';
    import { deriveBuildingModel } from '@nodouno/editor2d/derivedModel';
    import { polygonArea } from '@nodouno/editor2d/geometry';
    import { migrateDrawingData, toLegacyFreeDrawing } from '@nodouno/editor2d/migration';
    import {
      DEFAULT_PROJECT_SPECS,
      concreteStrengthMpa,
      normalizeProjectSpecs
    } from '@nodouno/shared';

    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');
    const activeProjectLabel = document.querySelector('#active-project-label');
    const editorStatus = document.querySelector('#editor-status');
    const stepPills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-step-pill]'));
    const stepPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const prevStepBtn = document.querySelector<HTMLButtonElement>('#prev-step-btn');
    const nextStepBtn = document.querySelector<HTMLButtonElement>('#next-step-btn');
    const runCalcBtn = document.querySelector<HTMLButtonElement>('#run-calc-btn');
    const step4CalcStatus = document.querySelector<HTMLElement>('#step4-calc-status');
    const step4TechPanel = document.querySelector<HTMLElement>('#step4-tech-panel');
    const model3dContainer = document.querySelector<HTMLElement>('#model-3d-container');
    const createRevisionBtn = document.querySelector<HTMLButtonElement>('#create-revision-btn');
    const revisionCommentInput = document.querySelector<HTMLInputElement>('#revision-comment-input');
    const revisionsStatus = document.querySelector<HTMLElement>('#revisions-status');
    const revisionsList = document.querySelector<HTMLElement>('#revisions-list');
    const exportJsonBtn = document.querySelector<HTMLButtonElement>('#export-json-btn');
    const exportPdfBtn = document.querySelector<HTMLButtonElement>('#export-pdf-btn');
    const exportStatus = document.querySelector<HTMLElement>('#export-status');
    const loadsCanvas = document.querySelector<HTMLCanvasElement>('#loads-canvas');
    const loadsHudStatus = document.querySelector<HTMLElement>('#loads-hud-status');
    const loadsFitBtn = document.querySelector<HTMLButtonElement>('#loads-fit');
    const loadsZoomInBtn = document.querySelector<HTMLButtonElement>('#loads-zoom-in');
    const loadsZoomOutBtn = document.querySelector<HTMLButtonElement>('#loads-zoom-out');
    const step3Validation = document.querySelector<HTMLElement>('#step3-validation');
    const step3NoSlabs = document.querySelector<HTMLElement>('#step3-no-slabs');
    const step3LoadsPanel = document.querySelector<HTMLElement>('#step3-loads-panel');
    const step3SlabPicker = document.querySelector<HTMLSelectElement>('#step3-slab-picker');
    const step3LoadFields = document.querySelector<HTMLElement>('#step3-load-fields');
    const step3LoadPreview = document.querySelector<HTMLElement>('#step3-load-preview');
    const helpToggle = document.querySelector<HTMLButtonElement>('#cad-help-toggle');
    const helpPanel = document.querySelector<HTMLElement>('#cad-help-panel');
    const saveDrawingBtn = document.querySelector<HTMLButtonElement>('#save-drawing-btn');
    const clearDrawingBtn = document.querySelector<HTMLButtonElement>('#clear-drawing-btn');
    const undoBtn = document.querySelector<HTMLButtonElement>('#cad-undo');
    const redoBtn = document.querySelector<HTMLButtonElement>('#cad-redo');
    const deleteBtn = document.querySelector<HTMLButtonElement>('#cad-delete');
    const fitBtn = document.querySelector<HTMLButtonElement>('#cad-fit');
    const zoomInBtn = document.querySelector<HTMLButtonElement>('#cad-zoom-in');
    const zoomOutBtn = document.querySelector<HTMLButtonElement>('#cad-zoom-out');
    const resetViewBtn = document.querySelector<HTMLButtonElement>('#cad-reset-view');
    const toolButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tool]'));
    const hudTool = document.querySelector<HTMLElement>('#hud-tool');
    const hudSnap = document.querySelector<HTMLElement>('#hud-snap');
    const hudOrtho = document.querySelector<HTMLElement>('#hud-ortho');
    const hudSnapKind = document.querySelector<HTMLElement>('#hud-snap-kind');
    const hudStatus = document.querySelector<HTMLElement>('#hud-status');
    const hudCoords = document.querySelector<HTMLElement>('#hud-coords');
    const hudZoom = document.querySelector<HTMLElement>('#hud-zoom');
    const hudMeasure = document.querySelector<HTMLElement>('#hud-measure');
    const selectionSummary = document.querySelector<HTMLElement>('#cad-selection-summary');
    const propSelection = document.querySelector<HTMLFieldSetElement>('#prop-selection');
    const propSelectionFields = document.querySelector<HTMLElement>('#prop-selection-fields');
    const propDefaultsColumn = document.querySelector<HTMLFieldSetElement>('#prop-defaults-column');
    const propDefaultsBeam = document.querySelector<HTMLFieldSetElement>('#prop-defaults-beam');
    const propDefaultsSlab = document.querySelector<HTMLFieldSetElement>('#prop-defaults-slab');
    const propDefaultColW = document.querySelector<HTMLInputElement>('#prop-default-col-w');
    const propDefaultColD = document.querySelector<HTMLInputElement>('#prop-default-col-d');
    const propDefaultBeamW = document.querySelector<HTMLInputElement>('#prop-default-beam-w');
    const propDefaultBeamD = document.querySelector<HTMLInputElement>('#prop-default-beam-d');
    const propDefaultSlabT = document.querySelector<HTMLInputElement>('#prop-default-slab-t');
    const specRegulation = document.querySelector<HTMLSelectElement>('#spec-regulation');
    const specSteel = document.querySelector<HTMLSelectElement>('#spec-steel');
    const specConcrete = document.querySelector<HTMLSelectElement>('#spec-concrete');
    const specsStatus = document.querySelector<HTMLElement>('#specs-status');
    const canvas = document.querySelector<HTMLCanvasElement>('#cad-canvas');

    const queryProjectId = new URLSearchParams(window.location.search).get('project');
    const activeProjectId = queryProjectId || localStorage.getItem('active-project-id');
    const activeProjectName = localStorage.getItem('active-project-name');

    let currentStep: 1 | 2 | 3 | 4 = 1;
    let activeTool: ToolKind = 'select';
    let lastPropertiesHudKey = '';
    let editor: Editor2DHandle | null = null;
    let loadsStep: ReturnType<typeof initEditorLoadsStep> | null = null;
    let drawingDirty = false;
    let simplifiedModel: BuildingInput | null = null;
    let pipelineResults: CalcPipelineResults | null = null;
    let viewer3d: ReturnType<typeof createStructuralViewer3d> | null = null;
    let selectedElementId: string | null = null;
    let selectedElementType: ElementType | null = null;
    let projectSpecs = DEFAULT_PROJECT_SPECS;
    let revisionsPanel: ReturnType<typeof initEditorRevisionsPanel> | null = null;

    const setEditorStatus = (message: string, isError = false) => {
      if (!editorStatus) return;
      editorStatus.textContent = message;
      editorStatus.classList.toggle('text-desert-sienna', isError);
      editorStatus.classList.toggle('text-slate-mist', !isError);
    };

    const setSpecsStatus = (message: string, isError = false) => {
      if (!specsStatus) return;
      specsStatus.textContent = message;
      specsStatus.classList.toggle('text-desert-sienna', isError);
      specsStatus.classList.toggle('text-slate-mist', !isError);
    };

    const setStep4CalcStatus = (message: string, isError = false) => {
      if (!step4CalcStatus) return;
      step4CalcStatus.textContent = message;
      step4CalcStatus.classList.toggle('text-desert-sienna', isError);
      step4CalcStatus.classList.toggle('text-slate-mist', !isError);
    };

    const syncSpecsControls = () => {
      if (specRegulation) specRegulation.value = projectSpecs.regulation;
      if (specSteel) specSteel.value = projectSpecs.steel;
      if (specConcrete) specConcrete.value = projectSpecs.concrete;
    };

    const setExportStatus = (message: string, isError = false) => {
      if (!exportStatus) return;
      exportStatus.textContent = message;
      exportStatus.classList.toggle('text-desert-sienna', isError);
      exportStatus.classList.toggle('text-slate-mist', !isError);
    };

    let setStep: (step: 1 | 2 | 3 | 4) => Promise<void>;

    stepPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const step = Number(pill.getAttribute('data-step-pill')) as 1 | 2 | 3 | 4;
        if (step === 1 || step === 2 || step === 3 || step === 4) void setStep(step);
      });
    });

    const persistProject = async (values: Record<string, unknown>) => {
      if (!activeProjectId) return { error: new Error('Proyecto no seleccionado.') };
      try {
        await updateProject(activeProjectId, values);
        return { error: null };
      } catch (error) {
        return { error: error instanceof Error ? error : new Error(String(error)) };
      }
    };

    let persistDrawingTimer: ReturnType<typeof setTimeout> | null = null;

    const persistDrawingFromEditor = async () => {
      if (!editor || !activeProjectId) return;
      const state = editor.getState();
      const payload = {
        ...state,
        createdAt: new Date().toISOString(),
        freeDrawing: toLegacyFreeDrawing(state)
      };
      const { error } = await persistProject({ drawing_data: payload });
      if (error) {
        setEditorStatus(`No se pudo guardar cargas: ${error.message}`, true);
        return;
      }
      drawingDirty = false;
    };

    const schedulePersistDrawing = () => {
      drawingDirty = true;
      if (persistDrawingTimer) clearTimeout(persistDrawingTimer);
      persistDrawingTimer = setTimeout(() => {
        void persistDrawingFromEditor();
      }, 700);
    };

    loadsStep = initEditorLoadsStep({
      getMainEditor: () => editor,
      onSlabPatched: schedulePersistDrawing,
      elements: {
        canvas: loadsCanvas,
        hudStatus: loadsHudStatus,
        validation: step3Validation,
        noSlabs: step3NoSlabs,
        loadsPanel: step3LoadsPanel,
        slabPicker: step3SlabPicker,
        loadFields: step3LoadFields,
        loadPreview: step3LoadPreview,
        fitBtn: loadsFitBtn,
        zoomInBtn: loadsZoomInBtn,
        zoomOutBtn: loadsZoomOutBtn
      }
    });

    const refreshSimplifiedModelFromEditor = (): boolean => {
      if (!editor) return Boolean(simplifiedModel);
      const derived = deriveBuildingModel(editor.getState());
      if ('error' in derived) {
        setEditorStatus(derived.error, true);
        return false;
      }
      simplifiedModel = derived.model;
      simplifiedModel.materials.fckMpa = concreteStrengthMpa(projectSpecs.concrete);
      simplifiedModel.materials.fyMpa = 420;
      if (derived.warnings.length > 0) loadsStep?.showValidation(derived.warnings);
      return true;
    };

    const updateActiveToolButton = (tool: ToolKind) => {
      toolButtons.forEach((btn) => {
        const isActive = btn.getAttribute('data-tool') === tool;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    const formatMeters = (n: number) => `${n.toFixed(3)} m`;
    const formatArea = (n: number) => `${n.toFixed(3)} m²`;

    const renderMeasure = (measure: HudInfo['measure']) => {
      if (!hudMeasure) return;
      if (!measure) {
        hudMeasure.classList.add('hidden');
        hudMeasure.textContent = '';
        return;
      }
      const parts: string[] = [];
      if (typeof measure.lengthM === 'number') parts.push(`L: ${formatMeters(measure.lengthM)}`);
      if (typeof measure.widthM === 'number') parts.push(`W: ${formatMeters(measure.widthM)}`);
      if (typeof measure.heightM === 'number') parts.push(`H: ${formatMeters(measure.heightM)}`);
      if (typeof measure.areaM2 === 'number') parts.push(`A: ${formatArea(measure.areaM2)}`);
      if (typeof measure.sideCount === 'number') parts.push(`n=${measure.sideCount}`);
      if (parts.length === 0) {
        hudMeasure.classList.add('hidden');
        hudMeasure.textContent = '';
        return;
      }
      hudMeasure.classList.remove('hidden');
      hudMeasure.textContent = parts.join(' · ');
    };

    const renderHud = (hud: HudInfo) => {
      if (hudCoords)
        hudCoords.textContent = hud.cursor
          ? `x: ${hud.cursor.x.toFixed(3)} m · y: ${hud.cursor.y.toFixed(3)} m`
          : 'x: — · y: —';
      if (hudZoom) hudZoom.textContent = `Escala: ${Math.round(hud.zoom)} px/m`;
      if (hudTool) hudTool.textContent = hud.tool.charAt(0).toUpperCase() + hud.tool.slice(1);
      if (hudSnap) hudSnap.textContent = `Snap: ${hud.snap.enabled ? 'ON' : 'OFF'}`;
      if (hudOrtho) hudOrtho.textContent = `Ortho: ${hud.ortho ? 'ON' : 'OFF'}`;
      if (hudSnapKind) {
        if (hud.snap.kind === 'none') {
          hudSnapKind.classList.add('hidden');
        } else {
          hudSnapKind.classList.remove('hidden');
          hudSnapKind.textContent = `→ ${hud.snap.kind}`;
        }
      }
      if (hudStatus) hudStatus.textContent = hud.status;
      if (undoBtn) undoBtn.disabled = !hud.canUndo;
      if (redoBtn) redoBtn.disabled = !hud.canRedo;
      updateActiveToolButton(hud.tool);
      renderMeasure(hud.measure);
      activeTool = hud.tool;
      const selKey = hud.selectionIds.join(',');
      const hudKey = `${hud.tool}:${hud.selectionCount}:${selKey}`;
      if (hudKey !== lastPropertiesHudKey) {
        lastPropertiesHudKey = hudKey;
        renderPropertiesPanel(hud.tool);
      }
    };

    const hideAllDefaultPropGroups = () => {
      propDefaultsColumn?.classList.add('hidden');
      propDefaultsBeam?.classList.add('hidden');
      propDefaultsSlab?.classList.add('hidden');
    };

    const showDefaultPropGroup = (kind: 'column' | 'beam' | 'slab') => {
      hideAllDefaultPropGroups();
      if (kind === 'column') propDefaultsColumn?.classList.remove('hidden');
      if (kind === 'beam') propDefaultsBeam?.classList.remove('hidden');
      if (kind === 'slab') propDefaultsSlab?.classList.remove('hidden');
    };

    const renderPropertiesPanel = (tool: ToolKind = activeTool) => {
      if (!editor || !selectionSummary || !propSelection || !propSelectionFields) return;
      activeTool = tool;
      const entities = editor.getSelectionEntities();
      propSelectionFields.innerHTML = '';
      hideAllDefaultPropGroups();

      if (entities.length === 0) {
        propSelection.classList.add('hidden');
        if (tool === 'column') {
          showDefaultPropGroup('column');
          selectionSummary.textContent = 'Nueva columna — ajusta dimensiones antes de colocar.';
        } else if (tool === 'beam') {
          showDefaultPropGroup('beam');
          selectionSummary.textContent = 'Nueva viga — ajusta seccion antes de dibujar.';
        } else if (tool === 'slab') {
          showDefaultPropGroup('slab');
          selectionSummary.textContent = 'Nueva losa — ajusta espesor antes de dibujar.';
        } else {
          selectionSummary.textContent =
            tool === 'pan'
              ? 'Pan activo. Cambia a seleccion o una herramienta de dibujo.'
              : 'Sin seleccion. Elige herramienta o selecciona un elemento.';
        }
        return;
      }
      propSelection.classList.remove('hidden');
      if (entities.length > 1) {
        selectionSummary.textContent = `Seleccion multiple: ${entities.length} elementos.`;
        propSelection.classList.add('hidden');
        return;
      }
      const entity = entities[0];
      const typeLabels: Record<string, string> = { column: 'Columna', beam: 'Viga', slab: 'Losa' };
      const typeLabel = typeLabels[entity.type] ?? entity.type;
      if (propSelection.querySelector('legend')) {
        propSelection.querySelector('legend')!.textContent = typeLabel;
      }
      selectionSummary.textContent = `${typeLabel} · ${entity.id.slice(-4)}`;

      const numberInput = (label: string, value: number, step: number, onCommit: (v: number) => void) => {
        const wrapper = document.createElement('label');
        wrapper.className = 'grid gap-8';
        const span = document.createElement('span');
        span.className = 'text-body-sm font-semibold';
        span.textContent = label;
        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'cad-input';
        input.step = String(step);
        input.value = String(value);
        input.addEventListener('change', () => {
          const v = Number(input.value);
          if (Number.isFinite(v)) onCommit(v);
        });
        wrapper.appendChild(span);
        wrapper.appendChild(input);
        return wrapper;
      };

      if (entity.type === 'column') {
        propSelectionFields.appendChild(
          numberInput('Ancho (m)', entity.widthM, 0.05, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'column' ? { ...e, widthM: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Alto (m)', entity.depthM, 0.05, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'column' ? { ...e, depthM: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Centro X (m)', entity.cx, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'column' ? { ...e, cx: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Centro Y (m)', entity.cy, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'column' ? { ...e, cy: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Rotacion (°)', (entity.rotation * 180) / Math.PI, 5, (v) =>
            editor!.updateSelectionProps((e) =>
              e.type === 'column' ? { ...e, rotation: (v * Math.PI) / 180 } : e
            )
          )
        );
      } else if (entity.type === 'beam') {
        propSelectionFields.appendChild(
          numberInput('Ancho (m)', entity.widthM, 0.05, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, widthM: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Canto (m)', entity.depthM, 0.05, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, depthM: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('X1 (m)', entity.x1, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, x1: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Y1 (m)', entity.y1, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, y1: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('X2 (m)', entity.x2, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, x2: v } : e))
          )
        );
        propSelectionFields.appendChild(
          numberInput('Y2 (m)', entity.y2, 0.1, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'beam' ? { ...e, y2: v } : e))
          )
        );
      } else if (entity.type === 'slab') {
        propSelectionFields.appendChild(
          numberInput('Espesor (m)', entity.thicknessM, 0.01, (v) =>
            editor!.updateSelectionProps((e) => (e.type === 'slab' ? { ...e, thicknessM: v } : e))
          )
        );

        const info = document.createElement('p');
        info.className = 'text-slate-mist';
        info.textContent = `Vértices: ${entity.points.length} · Área: ${formatArea(polygonArea(entity.points))}`;
        propSelectionFields.appendChild(info);
      }
    };

    const hydrateProjectPipelineResults = (
      calculations: unknown,
      dimensioning: unknown
    ): CalcPipelineResults | null =>
      hydratePipelineResults(calculations, dimensioning, simplifiedModel);

    const applyProjectSnapshot = (snapshot: {
      drawing_data?: unknown;
      simplified_model?: unknown;
      calculations?: unknown;
      dimensioning?: unknown;
    }) => {
      if (editor && snapshot.drawing_data) {
        editor.setState(migrateDrawingData(snapshot.drawing_data), { commit: true });
        drawingDirty = false;
        renderPropertiesPanel();
      }

      simplifiedModel = snapshot.simplified_model
        ? normalizeBuildingInput(snapshot.simplified_model)
        : null;
      pipelineResults = hydrateProjectPipelineResults(snapshot.calculations, snapshot.dimensioning);
      selectedElementId = null;
      selectedElementType = null;

      if (currentStep === 3) {
        loadsStep?.enter();
      }
      if (currentStep === 4) {
        if (pipelineResults) {
          setStep4CalcStatus('Resultados restaurados desde revision.');
        } else {
          setStep4CalcStatus('Modelo restaurado. Pulse Calcular para obtener resultados.');
        }
        sync3dViewer();
        refreshTechnicalPanel();
      }
    };

    const refreshTechnicalPanel = () => {
      if (!step4TechPanel) return;
      renderTechnicalPanel(
        step4TechPanel,
        simplifiedModel,
        pipelineResults,
        selectedElementId,
        selectedElementType
      );
    };

    const onStructuralSelect = (elementId: string, elementType: ElementType) => {
      selectedElementId = elementId;
      selectedElementType = elementType;
      viewer3d?.selectElement(elementId, elementType);
      refreshTechnicalPanel();
    };

    const sync3dViewer = () => {
      if (!model3dContainer) return;
      refreshSimplifiedModelFromEditor();
      if (!simplifiedModel) return;

      let mountAttempts = 0;
      const mount = () => {
        if (!model3dContainer || !simplifiedModel) return;
        const w = model3dContainer.clientWidth;
        const h = model3dContainer.clientHeight;
        if ((w < 4 || h < 4) && mountAttempts < 120) {
          mountAttempts += 1;
          requestAnimationFrame(mount);
          return;
        }

        const canvas = model3dContainer.querySelector('canvas');
        if (viewer3d && canvas && (canvas.width < 4 || canvas.height < 4)) {
          viewer3d.dispose();
          viewer3d = null;
        }

        const hasResults = Boolean(pipelineResults);
        if (!viewer3d) {
          viewer3d = createStructuralViewer3d(model3dContainer, simplifiedModel, onStructuralSelect);
        } else {
          viewer3d.setModel(simplifiedModel);
          viewer3d.setResultsVisible(hasResults);
          viewer3d.resize();
        }
        if (selectedElementId && selectedElementType) {
          viewer3d.selectElement(selectedElementId, selectedElementType);
        }
      };

      requestAnimationFrame(mount);
    };

    const prepareModelFromDrawing = async (): Promise<boolean> => {
      if (!editor) return false;
      if (!refreshSimplifiedModelFromEditor()) return false;
      if (activeProjectId && simplifiedModel) {
        await persistProject({
          simplified_model: simplifiedModel,
          status: 'loaded'
        });
      }
      return Boolean(simplifiedModel);
    };

    const enterStep4 = () => {
      requestAnimationFrame(() => {
        if (!simplifiedModel) {
          setStep4CalcStatus('Complete el paso 3 (cargas) antes de calcular.', true);
          return;
        }
        sync3dViewer();
        if (pipelineResults) {
          refreshTechnicalPanel();
          setStep4CalcStatus('Resultados cargados. Seleccione un elemento en 3D.');
        } else {
          setStep4CalcStatus('Modelo en 3D. Pulse Calcular para obtener resultados.');
        }
      });
    };

    setStep = async (step: 1 | 2 | 3 | 4) => {
      const prev = currentStep;
      if (prev === 3 && step !== 3) {
        const issues = step === 4 ? (loadsStep?.validate() ?? []) : [];
        if (step === 4 && issues.length > 0) {
          loadsStep?.showValidation(issues);
          setEditorStatus('Complete las cargas por losa antes de avanzar.', true);
          return;
        }
        if (editor && activeProjectId) {
          if (persistDrawingTimer) {
            clearTimeout(persistDrawingTimer);
            persistDrawingTimer = null;
          }
          await persistDrawingFromEditor();
        }
      }
      if (step === 4 && editor) {
        const ok = await prepareModelFromDrawing();
        if (!ok) return;
      }

      currentStep = step;
      stepPanels.forEach((panel) => {
        const panelStep = Number(panel.getAttribute('data-step-panel'));
        panel.classList.toggle('hidden', panelStep !== currentStep);
      });
      stepPills.forEach((pill) => {
        const pillStep = Number(pill.getAttribute('data-step-pill'));
        const isActive = pillStep === currentStep;
        pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      if (nextStepBtn) {
        const label = currentStep === 4 ? 'Flujo completado' : 'Paso siguiente';
        nextStepBtn.setAttribute('aria-label', label);
        nextStepBtn.setAttribute('title', label);
        nextStepBtn.toggleAttribute('disabled', currentStep === 4);
      }
      if (step === 2 && editor) {
        requestAnimationFrame(() => editor!.fit());
      }
      if (step === 3) {
        loadsStep?.enter();
      }
      if (step === 4) {
        enterStep4();
      }
    };

    if (!supabase) {
      window.location.href = '/login';
    } else {
      try {
        const session = await requireSession();
        if (sessionLabel) {
          sessionLabel.textContent = `Sesion como ${session.user.email ?? 'usuario'}.`;
        }
      } catch {
        window.location.href = '/login';
      }

      try {
        const catalogs = await listCatalogs();
        if (specRegulation) {
          specRegulation.innerHTML = catalogs.regulations
            .map((item) => {
              const label = 'name' in item && typeof item.name === 'string' ? item.name : item.code;
              return `<option value="${item.code}">${label}</option>`;
            })
            .join('');
        }
        if (specSteel) {
          specSteel.innerHTML = catalogs.steel
            .map((item) => `<option value="${item.code}">${item.code}</option>`)
            .join('');
        }
        if (specConcrete) {
          specConcrete.innerHTML = catalogs.concrete
            .map((item) => `<option value="${item.code}">${item.code}</option>`)
            .join('');
        }
      } catch (error) {
        setSpecsStatus(
          `Catálogos no disponibles (${(error as Error).message}). Usando valores por defecto.`,
          true
        );
      }
    }

    if (!activeProjectId) {
      if (activeProjectLabel) {
        activeProjectLabel.textContent = 'Sin proyecto activo';
      }
      setEditorStatus('Selecciona un proyecto en dashboard para seguir.', true);
    } else if (activeProjectLabel) {
      activeProjectLabel.textContent = `${activeProjectName ?? 'Proyecto'}`;
    }

    let initialDrawing: DrawingState | null = null;
    if (activeProjectId) {
      let projectData: ProjectDetail | null | undefined;
      try {
        projectData = await getProject(activeProjectId);
      } catch (error) {
        setEditorStatus(`No se pudo cargar el proyecto: ${(error as Error).message ?? error}`, true);
      }

      projectSpecs = normalizeProjectSpecs(projectData?.specs);
      syncSpecsControls();
      setSpecsStatus('Especificaciones listas.');

      if (projectData?.drawing_data) {
        initialDrawing = migrateDrawingData(projectData.drawing_data);
      }
      if (projectData?.simplified_model) {
        simplifiedModel = normalizeBuildingInput(projectData.simplified_model);
      }
      if (projectData?.calculations || projectData?.dimensioning) {
        pipelineResults = hydrateProjectPipelineResults(
          projectData.calculations,
          projectData.dimensioning
        );
        if (pipelineResults) {
          setStep4CalcStatus('Resultados cargados desde proyecto.');
        }
      }

      revisionsPanel = initEditorRevisionsPanel({
        projectId: activeProjectId,
        projectName: activeProjectName,
        elements: {
          list: revisionsList,
          status: revisionsStatus,
          commentInput: revisionCommentInput,
          createBtn: createRevisionBtn
        },
        getSnapshotForCreate: () => {
          if (!editor) throw new Error('Editor no disponible.');
          return {
            drawing_data: {
              ...editor.getState(),
              createdAt: new Date().toISOString(),
              freeDrawing: toLegacyFreeDrawing(editor.getState())
            },
            simplified_model: simplifiedModel ?? undefined,
            calculations: pipelineResults?.calculations,
            dimensioning: pipelineResults?.dimensioning
          };
        },
        onSnapshotRestored: applyProjectSnapshot,
        setExportStatus,
        setEditorStatus
      });
      revisionsPanel.setCurrentRevisionId(projectData?.current_revision_id ?? null);
    }

    if (canvas) {
      editor = mountEditor2d(canvas, {
        initialState: initialDrawing ?? undefined,
        initialTool: 'select',
        onChange: () => {
          drawingDirty = true;
          renderPropertiesPanel();
          if (currentStep === 3) {
            loadsStep?.syncFromMainEditor();
            loadsStep?.renderPanel();
          }
        },
        onHud: (hud) => {
          renderHud(hud);
        }
      });
      renderPropertiesPanel();
      editor.fit();
    }

    if (revisionsPanel) {
      await revisionsPanel.renderItems();
    }

    void setStep(1);

    if (!activeProjectId) {
      projectSpecs = DEFAULT_PROJECT_SPECS;
      syncSpecsControls();
      setSpecsStatus('Sin proyecto activo.', true);
    }

    window.addEventListener('pagehide', () => {
      viewer3d?.dispose();
      viewer3d = null;
      loadsStep?.dispose();
      editor?.dispose();
      editor = null;
    });

    const persistSpecs = async () => {
      if (!activeProjectId) return;
      projectSpecs = normalizeProjectSpecs({
        regulation: specRegulation?.value ?? projectSpecs.regulation,
        steel: specSteel?.value ?? projectSpecs.steel,
        concrete: specConcrete?.value ?? projectSpecs.concrete
      });
      syncSpecsControls();
      setSpecsStatus('Guardando...');
      const { error } = await persistProject({ specs: projectSpecs });
      if (error && /column .*specs.*does not exist/i.test(error.message)) {
        setSpecsStatus('Falta migracion de DB para persistir.', true);
        return;
      }
      if (error) {
        setSpecsStatus(`Error: ${error.message}`, true);
        return;
      }
      setSpecsStatus('Guardadas.');
    };

    [specRegulation, specSteel, specConcrete].forEach((el) => el?.addEventListener('change', persistSpecs));

    toolButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tool = btn.getAttribute('data-tool') as ToolKind | null;
        if (!tool || !editor) return;
        editor.setTool(tool);
        activeTool = tool;
        renderPropertiesPanel(tool);
      });
    });

    undoBtn?.addEventListener('click', () => editor?.undo());
    redoBtn?.addEventListener('click', () => editor?.redo());
    deleteBtn?.addEventListener('click', () => editor?.deleteSelection());
    fitBtn?.addEventListener('click', () => editor?.fit());
    zoomInBtn?.addEventListener('click', () => editor?.zoomIn());
    zoomOutBtn?.addEventListener('click', () => editor?.zoomOut());
    resetViewBtn?.addEventListener('click', () => editor?.resetView());

    helpToggle?.addEventListener('click', () => {
      helpPanel?.classList.toggle('hidden');
    });

    const applyDefaultsToEditor = () => {
      if (!editor) return;
      editor.setColumnSection({
        widthM: Number(propDefaultColW?.value) || 0.35,
        depthM: Number(propDefaultColD?.value) || 0.35
      });
      editor.setBeamSection({
        widthM: Number(propDefaultBeamW?.value) || 0.25,
        depthM: Number(propDefaultBeamD?.value) || 0.5
      });
      editor.setSlabThicknessM(Number(propDefaultSlabT?.value) || 0.2);
    };
    applyDefaultsToEditor();
    [propDefaultColW, propDefaultColD, propDefaultBeamW, propDefaultBeamD, propDefaultSlabT].forEach((input) => {
      input?.addEventListener('change', applyDefaultsToEditor);
    });

    saveDrawingBtn?.addEventListener('click', async () => {
      if (!editor) return;
      const state = editor.getState();
      const payload = {
        ...state,
        createdAt: new Date().toISOString(),
        freeDrawing: toLegacyFreeDrawing(state)
      };
      setEditorStatus('Guardando drawing_data...');
      const { error } = await persistProject({ drawing_data: payload, status: 'drawn' });
      if (error) {
        setEditorStatus(`Error al guardar dibujo: ${error.message}`, true);
        return;
      }
      drawingDirty = false;
      setEditorStatus('Dibujo 2D guardado.');
    });

    clearDrawingBtn?.addEventListener('click', () => {
      if (!editor) return;
      editor.setState(
        {
          version: 4,
          createdAt: new Date().toISOString(),
          grid: editor.getState().grid,
          entities: { columns: [], beams: [], slabs: [] }
        },
        { commit: true }
      );
      renderPropertiesPanel();
      setEditorStatus('Dibujo limpiado.');
    });

    runCalcBtn?.addEventListener('click', async () => {
      if (editor) {
        const issues = loadsStep?.validate() ?? [];
        if (issues.length > 0) {
          loadsStep?.showValidation(issues);
          setStep4CalcStatus('Complete cargas en paso 3.', true);
          return;
        }
        if (persistDrawingTimer) {
          clearTimeout(persistDrawingTimer);
          persistDrawingTimer = null;
        }
        await persistDrawingFromEditor();
        const ok = await prepareModelFromDrawing();
        if (!ok) {
          setStep4CalcStatus('Modelo no disponible.', true);
          return;
        }
      }
      if (!simplifiedModel) {
        setEditorStatus('Complete cargas en el paso 3 antes de calcular.', true);
        setStep4CalcStatus('Modelo no disponible.', true);
        return;
      }
      const model = normalizeBuildingInput(simplifiedModel);
      setEditorStatus('Ejecutando cálculo en servidor...');
      setStep4CalcStatus('Calculando...');
      if (runCalcBtn) runCalcBtn.disabled = true;

      let result: CalcPipelineResults | null = null;
      try {
        result = await runServerCalc(model);
      } catch (error) {
        setEditorStatus(`Fallback a cálculo local: ${(error as Error).message}`, true);
      }
      if (!result) {
        const loads = calculateLoads(model);
        const demands = calculateDemands(model);
        const dimensioning = calculateDesign(model);
        result = { calculations: { loads, demands }, dimensioning };
      }

      pipelineResults = result;
      const { error: persistErr } = await persistProject({
        calculations: pipelineResults.calculations,
        dimensioning: pipelineResults.dimensioning,
        status: 'dimensioned'
      });
      if (persistErr) {
        setEditorStatus(`Cálculo listo, pero no se pudo guardar: ${persistErr.message}`, true);
        setStep4CalcStatus('Resultados en memoria; error al guardar.', true);
      } else {
        setEditorStatus('Cálculo y dimensionamiento guardados.');
        setStep4CalcStatus('Cálculo completado. Seleccione un elemento en 3D.');
      }

      sync3dViewer();
      if (!selectedElementId && simplifiedModel.slabs[0]) {
        selectedElementId = simplifiedModel.slabs[0].id;
        selectedElementType = 'slab';
        viewer3d?.selectElement(selectedElementId, selectedElementType);
      }
      refreshTechnicalPanel();
      if (runCalcBtn) runCalcBtn.disabled = false;
    });

    exportJsonBtn?.addEventListener('click', async () => {
      if (!activeProjectId) return;
      const lastRevisionId = revisionsPanel?.getLastRevisionId();
      try {
        setExportStatus('Exportando snapshot actual...');
        const result = await exportProjectJson(activeProjectId, lastRevisionId);
        const blob = new Blob([JSON.stringify(result.snapshot, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = `${activeProjectName ?? 'proyecto'}${lastRevisionId ? `-revision-${lastRevisionId.slice(-6)}` : '-actual'}.json`;
        anchor.click();
        URL.revokeObjectURL(url);
        setExportStatus('Exportación lista.');
      } catch (error) {
        setExportStatus((error as Error).message, true);
      }
    });

    exportPdfBtn?.addEventListener('click', async () => {
      if (!activeProjectId) return;
      const lastRevisionId = revisionsPanel?.getLastRevisionId();
      try {
        setExportStatus('Generando informe PDF en servidor...');
        const result = await exportProjectPdf(activeProjectId, lastRevisionId);
        downloadBase64File(result.filename, result.contentBase64, result.mimeType);
        setExportStatus('Informe PDF descargado desde API.');
      } catch (error) {
        try {
          setExportStatus('API no disponible. Generando PDF local...');
          downloadTechnicalReportPdf({
            projectName: activeProjectName ?? 'Proyecto',
            specs: projectSpecs,
            model: simplifiedModel,
            results: pipelineResults
          });
          setExportStatus(`PDF local listo. API: ${(error as Error).message}`);
        } catch (fallbackError) {
          setExportStatus((fallbackError as Error).message, true);
        }
      }
    });

    prevStepBtn?.addEventListener('click', () => {
      if (currentStep > 1) void setStep((currentStep - 1) as 1 | 2 | 3 | 4);
    });

    nextStepBtn?.addEventListener('click', async () => {
      if (currentStep === 1 && activeProjectId) {
        await persistSpecs();
      }
      if (currentStep === 2 && editor && activeProjectId) {
        const state = editor.getState();
        const payload = {
          ...state,
          createdAt: new Date().toISOString(),
          freeDrawing: toLegacyFreeDrawing(state)
        };
        await persistProject({ drawing_data: payload, status: 'drawn' });
        drawingDirty = false;
      }
      if (currentStep === 3) {
        const issues = loadsStep?.validate() ?? [];
        if (issues.length > 0) {
          loadsStep?.showValidation(issues);
          setEditorStatus('Complete las cargas por losa antes de avanzar.', true);
          return;
        }
      }
      if (currentStep < 4) await setStep((currentStep + 1) as 1 | 2 | 3 | 4);
    });

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    window.addEventListener('beforeunload', (event) => {
      if (drawingDirty) {
        event.preventDefault();
        event.returnValue = '';
      }
    });

  </script>
</Layout>
