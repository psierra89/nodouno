---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout>
  <main class="min-h-screen bg-canvas-white px-16 py-31 text-obsidian md:px-23">
    <section class="mx-auto w-full max-w-[1100px] rounded-3xl border border-obsidian p-22">
      <div class="mb-31 flex flex-col items-center gap-16 text-center">
        <h1 class="text-heading leading-heading tracking-heading">Dashboard</h1>
        <Button id="logout-btn" variant="dark">Cerrar sesion</Button>
      </div>
      <p id="session-label" class="mx-auto max-w-3xl text-center text-slate-mist">Comprobando sesion...</p>
      <section class="mt-23 rounded-3xl border border-obsidian p-22">
        <h2 class="text-heading-sm leading-heading-sm tracking-heading-sm">Nuevo proyecto</h2>
        <form id="new-project-form" class="mt-16 flex flex-col gap-13 md:flex-row md:items-end">
          <label class="flex-1 text-left">
            <span class="mb-11 block text-body-sm font-bold">Nombre del proyecto</span>
            <input
              id="project-name-input"
              name="projectName"
              type="text"
              maxlength="80"
              placeholder="Ej: Edificio oficinas norte"
              class="w-full rounded-full border border-obsidian bg-canvas-white px-22 pt-15 pb-16 text-body-sm text-obsidian outline-none focus:border-desert-sienna"
              required
            />
          </label>
          <label class="text-left">
            <span class="mb-11 block text-body-sm font-bold">Hormigon</span>
            <select
              id="project-concrete-select"
              name="projectConcrete"
              class="w-full rounded-full border border-obsidian bg-canvas-white px-22 pt-15 pb-16 text-body-sm text-obsidian outline-none focus:border-desert-sienna"
            >
              <option value="H25">H25</option>
              <option value="H30" selected>H30</option>
              <option value="H35">H35</option>
            </select>
          </label>
          <div class="flex gap-11">
            <Button id="create-project-btn" type="submit" variant="primary">Crear</Button>
            <button
              id="reset-project-form-btn"
              type="button"
              class="inline-flex items-center justify-center rounded-full border border-obsidian px-22 pt-15 pb-16 text-body-sm leading-none font-bold text-obsidian transition-colors hover:bg-obsidian hover:text-canvas-white"
            >
              Limpiar
            </button>
          </div>
        </form>
        <p id="project-form-status" class="mt-11 text-slate-mist" role="status" aria-live="polite">
          Completa el nombre para crear un proyecto nuevo.
        </p>
      </section>
      <section class="mt-38 text-center">
        <h2 class="text-heading-sm leading-heading-sm tracking-heading-sm">Tus proyectos</h2>
        <div id="projects-list" class="mt-22 grid gap-13">
          <p class="text-slate-mist">Cargando proyectos...</p>
        </div>
      </section>
    </section>
  </main>
  <script>
    import { supabase } from '../lib/supabase';
    import { createTrpcClient, getPublicApiUrl } from '../lib/trpc';
    import {
      DEFAULT_PROJECT_SPECS,
      normalizeProjectSpecs,
      normalizeProjectStatus
    } from '@nodouno/shared';
    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');
    const newProjectForm = document.querySelector('#new-project-form');
    const projectNameInput = document.querySelector('#project-name-input');
    const projectConcreteSelect = document.querySelector('#project-concrete-select');
    const resetProjectFormBtn = document.querySelector('#reset-project-form-btn');
    const projectFormStatus = document.querySelector('#project-form-status');
    const projectsList = document.querySelector('#projects-list');
    let currentSession = null;
    /** @type {Array<{ id: string; name: string; status: string; created_at?: string }>} */
    let lastProjects = [];
    let pendingDeleteId = null;

    const projectCardClass =
      'rounded-3xl border border-obsidian bg-canvas-white p-22 text-left shadow-none';

    const setProjectsMessage = (message) => {
      if (!projectsList) return;
      projectsList.innerHTML = `<p class="text-slate-mist">${message}</p>`;
    };

    const storeActiveProject = (project) => {
      localStorage.setItem('active-project-id', project.id);
      localStorage.setItem('active-project-name', project.name || 'Proyecto sin titulo');
      localStorage.setItem('active-project-status', normalizeProjectStatus(project.status ?? 'draft'));
    };

    const setFormStatus = (message, isError = false) => {
      if (!projectFormStatus) return;
      projectFormStatus.textContent = message;
      projectFormStatus.classList.toggle('text-desert-sienna', isError);
      projectFormStatus.classList.toggle('text-slate-mist', !isError);
    };

    const renderProjects = (projects) => {
      if (!projectsList) return;
      if (!projects || projects.length === 0) {
        pendingDeleteId = null;
        setProjectsMessage('Aun no tienes proyectos creados.');
        return;
      }

      projectsList.innerHTML = '';
      projects.forEach((project) => {
        const card = document.createElement('article');
        card.className = projectCardClass;

        const title = project.name || 'Proyecto sin titulo';
        const statusLabel = normalizeProjectStatus(project.status ?? 'draft');

        if (pendingDeleteId === project.id) {
          card.innerHTML = `
            <div class="space-y-16">
              <p class="text-body-sm font-bold text-obsidian">¿Eliminar este proyecto de forma permanente? Esta accion no se puede deshacer.</p>
              <div class="flex flex-wrap gap-11">
                <button type="button" data-cancel-delete="1" class="inline-flex items-center justify-center rounded-full border border-obsidian px-22 pt-15 pb-16 text-body-sm leading-none font-bold text-obsidian transition-colors hover:bg-obsidian hover:text-canvas-white">Cancelar</button>
                <button type="button" data-confirm-delete="${project.id}" class="inline-flex items-center justify-center rounded-full border border-obsidian px-22 pt-15 pb-16 text-body-sm leading-none font-bold text-obsidian transition-colors hover:bg-desert-sienna hover:text-canvas-white">Confirmar eliminacion</button>
              </div>
            </div>
          `;
        } else {
          card.innerHTML = `
            <div class="flex flex-wrap items-start justify-between gap-13">
              <div class="space-y-11">
                <h3 class="text-subheading leading-subheading tracking-subheading font-bold text-obsidian">${title}</h3>
                <p class="text-slate-mist">Estado: ${statusLabel}</p>
              </div>
              <div class="flex flex-wrap gap-11">
                <button type="button" data-open-id="${project.id}" class="inline-flex items-center justify-center rounded-full border border-obsidian bg-obsidian px-22 pt-15 pb-16 text-body-sm leading-none font-bold text-canvas-white transition-opacity hover:opacity-90">Abrir</button>
                <button type="button" data-request-delete="${project.id}" class="inline-flex items-center justify-center rounded-full border border-obsidian px-22 pt-15 pb-16 text-body-sm leading-none font-bold text-obsidian transition-colors hover:bg-obsidian hover:text-canvas-white">Eliminar</button>
              </div>
            </div>
          `;
        }

        projectsList.appendChild(card);
      });
    };

    const trpc = () =>
      createTrpcClient(async () => {
        if (!supabase) return null;
        const { data } = await supabase.auth.getSession();
        return data.session?.access_token ?? null;
      });

    const loadProjects = async () => {
      if (!supabase || !projectsList) return;
      const client = trpc();
      if (getPublicApiUrl() && client) {
        try {
          const projects = await client.projects.list.query();
          lastProjects = projects;
          renderProjects(lastProjects);
          return;
        } catch (e) {
          console.warn('tRPC list no disponible, fallback Supabase', e);
        }
      }
      const { data: projects, error } = await supabase
        .from('projects')
        .select('id, name, status, created_at')
        .order('created_at', { ascending: false });

      if (error) {
        setProjectsMessage('No se pudieron cargar tus proyectos.');
        return;
      }

      lastProjects = projects ?? [];
      renderProjects(lastProjects);
    };

    if (!supabase) {
      window.location.href = '/login';
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else if (sessionLabel) {
        currentSession = data.session;
        sessionLabel.textContent = `Sesion activa como ${data.session.user.email ?? 'usuario'}.`;
        await loadProjects();
      }
    }

    resetProjectFormBtn?.addEventListener('click', () => {
      if (!(projectNameInput instanceof HTMLInputElement)) return;
      projectNameInput.value = '';
      if (projectConcreteSelect instanceof HTMLSelectElement) {
        projectConcreteSelect.value = DEFAULT_PROJECT_SPECS.concrete;
      }
      setFormStatus('Completa el nombre para crear un proyecto nuevo.');
      projectNameInput.focus();
    });

    newProjectForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!supabase || !currentSession) return;
      if (!(projectNameInput instanceof HTMLInputElement)) return;

      const name = projectNameInput.value.trim();
      if (!name) {
        setFormStatus('Ingresa un nombre valido para continuar.', true);
        projectNameInput.focus();
        return;
      }

      setFormStatus('Creando proyecto...');

      const requestedSpecs = normalizeProjectSpecs({
        ...DEFAULT_PROJECT_SPECS,
        concrete:
          projectConcreteSelect instanceof HTMLSelectElement
            ? projectConcreteSelect.value
            : DEFAULT_PROJECT_SPECS.concrete
      });

      const client = trpc();
      if (getPublicApiUrl() && client) {
        try {
          await client.projects.create.mutate({ name, specs: requestedSpecs });
        } catch (e) {
          setFormStatus(`No se pudo crear el proyecto (API): ${(e as Error).message ?? e}`, true);
          return;
        }
      } else {
        const insertPayload = {
          name,
          status: 'draft',
          user_id: currentSession.user.id,
          specs: requestedSpecs
        };

        let { error } = await supabase.from('projects').insert(insertPayload);

        if (error && /column .*specs.*does not exist/i.test(error.message)) {
          const retry = await supabase.from('projects').insert({
            name,
            status: 'draft',
            user_id: currentSession.user.id
          });
          error = retry.error;
          if (!error) {
            setFormStatus('Proyecto creado, pero falta migracion de DB para guardar especificaciones.', true);
            await loadProjects();
            return;
          }
        }

        if (error) {
          setFormStatus(`No se pudo crear el proyecto: ${error.message}`, true);
          return;
        }
      }

      projectNameInput.value = '';
      if (projectConcreteSelect instanceof HTMLSelectElement) {
        projectConcreteSelect.value = DEFAULT_PROJECT_SPECS.concrete;
      }
      setFormStatus('Proyecto creado correctamente.');
      await loadProjects();
    });

    projectsList?.addEventListener('click', async (event) => {
      if (!supabase) return;
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const openId = target.dataset.openId;
      if (openId) {
        const { data, error } = await supabase
          .from('projects')
          .select('id, name, status')
          .eq('id', openId)
          .maybeSingle();

        if (error || !data) {
          setFormStatus('No se pudo abrir el proyecto seleccionado.', true);
          return;
        }

        storeActiveProject(data);
        window.location.href = `/editor?project=${openId}`;
      }

      const requestDeleteId = target.dataset.requestDelete;
      if (requestDeleteId) {
        pendingDeleteId = requestDeleteId;
        renderProjects(lastProjects);
        setFormStatus('Confirma o cancela la eliminacion en la tarjeta del proyecto.');
        return;
      }

      if (target.dataset.cancelDelete != null) {
        pendingDeleteId = null;
        renderProjects(lastProjects);
        setFormStatus('Eliminacion cancelada.');
        return;
      }

      const confirmDeleteId = target.dataset.confirmDelete;
      if (confirmDeleteId) {
        const client = trpc();
        if (getPublicApiUrl() && client) {
          try {
            await client.projects.delete.mutate({ id: confirmDeleteId });
          } catch (e) {
            setFormStatus(`No se pudo eliminar: ${(e as Error).message ?? e}`, true);
            return;
          }
        } else {
          const { error } = await supabase.from('projects').delete().eq('id', confirmDeleteId);
          if (error) {
            setFormStatus(`No se pudo eliminar: ${error.message}`, true);
            return;
          }
        }
        pendingDeleteId = null;
        setFormStatus('Proyecto eliminado.');
        await loadProjects();
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  </script>
</Layout>
