---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'dark' | 'ghost';
  class?: string;
}
const {
  href,
  type = 'button',
  variant = 'primary',
  class: className = '',
  ...rest
} = Astro.props;

const variantClasses = {
  primary:
    'bg-blueprint text-canvas-white border border-blueprint hover:bg-blueprint-deep hover:border-blueprint-deep',
  dark: 'bg-obsidian text-canvas-white border border-obsidian hover:bg-blueprint hover:border-blueprint',
  ghost:
    'bg-canvas-white text-obsidian border border-line-strong hover:border-obsidian hover:bg-obsidian hover:text-canvas-white'
};

const baseClasses =
  'inline-flex items-center justify-center gap-8 rounded-[6px] px-21 py-13 text-body-sm leading-none font-semibold no-underline transition-colors duration-150 disabled:cursor-not-allowed disabled:opacity-40';
---
{
  href ? (
    <a href={href} class={`${baseClasses} ${variantClasses[variant]} ${className}`} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={`${baseClasses} ${variantClasses[variant]} ${className}`} {...rest}>
      <slot />
    </button>
  )
}
