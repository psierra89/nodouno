---
import type { IconName } from '../lib/icons';
import { iconSvg } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---
<span class:list={['inline-flex shrink-0 items-center justify-center', className]} set:html={iconSvg(name, size)} />
