---
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'dark' | 'ghost';
  size?: 'md' | 'sm' | 'cad';
  icon: IconName;
  label: string;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  label,
  class: className = '',
  ...rest
} = Astro.props;

const variantClasses = {
  primary:
    'border border-blueprint bg-blueprint text-canvas-white hover:bg-blueprint-deep hover:border-blueprint-deep',
  dark: 'border border-obsidian bg-obsidian text-canvas-white hover:bg-blueprint hover:border-blueprint',
  ghost:
    'border border-line-strong bg-canvas-white text-obsidian hover:border-obsidian hover:bg-obsidian hover:text-canvas-white'
};

const sizeClasses = {
  md: 'h-[38px] w-[38px]',
  sm: 'h-[32px] w-[32px]',
  cad: 'h-[36px] w-[36px]'
};

const iconSize = size === 'sm' ? 16 : 18;

const baseClasses = [
  'inline-flex items-center justify-center rounded-[6px] transition-colors duration-150',
  'disabled:cursor-not-allowed disabled:opacity-40',
  sizeClasses[size],
  variantClasses[variant],
  className
].join(' ');
---
{
  href ? (
    <a
      href={href}
      class={baseClasses}
      title={label}
      aria-label={label}
      {...rest}
    >
      <Icon name={icon} size={iconSize} />
    </a>
  ) : (
    <button
      type={type}
      class={baseClasses}
      title={label}
      aria-label={label}
      {...rest}
    >
      <Icon name={icon} size={iconSize} />
    </button>
  )
}
