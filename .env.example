# --- apps/web (Vite / Astro, prefijo PUBLIC_) ---
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Opcional: URL del backend Node (`apps/api`) para tRPC (lista/crear proyectos vía API).
# PUBLIC_API_URL=http://localhost:4000

# --- apps/api (servidor, NO exponer en frontend) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
PORT=4000
HOST=0.0.0.0
# Origen(es) permitidos CORS, separados por coma (ej. https://tu-app.vercel.app)
# CORS_ORIGIN=http://localhost:4321

# --- packages/db (Drizzle / migraciones locales) ---
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
