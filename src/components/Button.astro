---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'dark' | 'ghost';
  class?: string;
}
const {
  href,
  type = 'button',
  variant = 'primary',
  class: className = '',
  ...rest
} = Astro.props;

const variantClasses = {
  primary: 'btn-primary',
  dark: 'btn-dark',
  ghost: 'btn-ghost'
};

const baseClasses =
  'btn-base';
---
{
  href ? (
    <a href={href} class={`${baseClasses} ${variantClasses[variant]} ${className}`} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={`${baseClasses} ${variantClasses[variant]} ${className}`} {...rest}>
      <slot />
    </button>
  )
}
