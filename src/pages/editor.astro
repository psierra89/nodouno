---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout>
  <main class="min-h-screen bg-canvas-white px-16 py-31 text-obsidian md:px-23">
    <section class="mx-auto w-full max-w-[1100px] rounded-3xl border border-obsidian p-22">
      <div class="mb-31 flex flex-wrap items-center justify-between gap-16">
        <h1 class="text-heading leading-heading tracking-heading">Editor</h1>
        <div class="flex flex-wrap gap-11">
          <Button id="go-dashboard-btn" variant="ghost" href="/dashboard">Dashboard</Button>
          <Button id="logout-btn" variant="dark">Cerrar sesion</Button>
        </div>
      </div>
      <p id="session-label" class="max-w-3xl text-slate-mist">
        Flujo MVP por fases: dibujo libre, cargas sobre modelo fijo y calculo base.
      </p>
      <div id="active-project" class="mt-23 rounded-3xl border border-obsidian p-22">
        <h2 class="text-subheading leading-subheading tracking-subheading">Proyecto activo</h2>
        <p id="active-project-label" class="mt-11 text-slate-mist">Sin seleccionar.</p>
      </div>

      <section class="mt-23 rounded-3xl border border-obsidian p-22">
        <h2 class="text-heading-sm leading-heading-sm tracking-heading-sm">Flujo por fases</h2>
        <div class="mt-16 grid gap-11 sm:grid-cols-3">
          <div data-step-pill="1" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 1: Dibujo 2D</div>
          <div data-step-pill="2" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 2: Cargas</div>
          <div data-step-pill="3" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 3: Calculo</div>
        </div>

        <section id="step-panel-1" data-step-panel="1" class="mt-22 rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 1 - Editor de planta 2D libre</h3>
          <p class="mt-11 text-slate-mist">
            Dibuja libremente columnas (rectangulos), vigas (lineas) y losas (rectangulo o poligono). Este dibujo se guarda en <code>drawing_data</code>.
          </p>
          <div class="mt-16 grid gap-11 lg:grid-cols-2">
            <div class="grid gap-11">
              <label class="flex flex-col gap-11">
                <span class="font-bold">Herramienta</span>
                <select id="draw-tool" class="rounded-full border border-obsidian px-22 pt-15 pb-16">
                  <option value="column">Columna (rectangulo)</option>
                  <option value="beam">Viga (linea)</option>
                  <option value="slabRect">Losa (rectangulo)</option>
                  <option value="slabPoly">Losa (poligono)</option>
                </select>
              </label>
              <div class="grid gap-11 sm:grid-cols-2">
                <label class="flex flex-col gap-11">
                  <span class="font-bold">Ancho columna (m)</span>
                  <input id="column-width" type="number" min="0.1" step="0.05" value="0.35" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
                <label class="flex flex-col gap-11">
                  <span class="font-bold">Alto columna (m)</span>
                  <input id="column-depth" type="number" min="0.1" step="0.05" value="0.35" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
              </div>
              <div class="flex flex-wrap gap-11">
                <Button id="finish-polygon-btn" variant="ghost">Cerrar poligono</Button>
                <Button id="clear-drawing-btn" variant="ghost">Limpiar dibujo</Button>
                <Button id="save-drawing-btn" variant="primary">Guardar dibujo</Button>
              </div>
            </div>
            <canvas id="editor-canvas" class="w-full rounded-3xl border border-obsidian" width="760" height="420"></canvas>
          </div>
          <p id="editor-status" class="mt-11 text-slate-mist" role="status" aria-live="polite">
            Dibuja en la planta y guarda para persistir.
          </p>
        </section>

        <section id="step-panel-2" data-step-panel="2" class="mt-22 hidden rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 2 - Cargas sobre modelo simplificado fijo</h3>
          <p class="mt-11 text-slate-mist">
            Para el MVP, el calculo ignora el dibujo libre y usa un modelo rectangular interno fijo (1 losa, 4 vigas, 4 columnas).
          </p>
          <form id="loads-form" class="mt-16 grid gap-11 sm:grid-cols-2">
            <label class="flex flex-col gap-11">
              <span class="font-bold">Luz modelo X (m)</span>
              <input id="span-x" type="number" min="2" step="0.1" value="5" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Luz modelo Y (m)</span>
              <input id="span-y" type="number" min="2" step="0.1" value="4" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Espesor losa (m)</span>
              <input id="slab-thickness" type="number" min="0.1" step="0.01" value="0.2" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Carga viva (kN/m2)</span>
              <input id="live-load" type="number" min="0" step="0.1" value="2" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11 sm:col-span-2">
              <span class="font-bold">Carga muerta adicional (kN/m2)</span>
              <input id="dead-load" type="number" min="0" step="0.1" value="1.5" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
          </form>
          <div class="mt-16 flex flex-wrap gap-11">
            <Button id="build-model-btn" variant="primary">Confirmar modelo simplificado</Button>
          </div>
          <pre id="model-output" class="mt-16 overflow-auto rounded-3xl border border-obsidian p-16 text-body-sm text-slate-mist">Pendiente.</pre>
        </section>

        <section id="step-panel-3" data-step-panel="3" class="mt-22 hidden rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 3 - Calculo y resultado base</h3>
          <p class="mt-11 text-slate-mist">Ejecuta el motor de calculo sobre el modelo simplificado fijo definido en el paso 2.</p>
          <div class="mt-16 flex flex-wrap gap-11">
            <Button id="run-calc-btn" variant="dark">Ejecutar calculo</Button>
          </div>
          <pre id="calc-output" class="mt-16 overflow-auto rounded-3xl border border-obsidian p-16 text-body-sm text-slate-mist">Pendiente.</pre>
        </section>

        <div class="mt-22 flex flex-wrap items-center justify-between gap-11">
          <Button id="prev-step-btn" variant="ghost">Anterior</Button>
          <Button id="next-step-btn" variant="dark">Siguiente</Button>
        </div>
      </section>
    </section>
  </main>

  <script>
    import { supabase } from '../lib/supabase';
    import { calculateDemands, calculateDesign, calculateLoads } from '../calc';

    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');
    const activeProjectLabel = document.querySelector('#active-project-label');
    const drawToolSelect = document.querySelector('#draw-tool');
    const finishPolygonBtn = document.querySelector('#finish-polygon-btn');
    const clearDrawingBtn = document.querySelector('#clear-drawing-btn');
    const saveDrawingBtn = document.querySelector('#save-drawing-btn');
    const buildModelBtn = document.querySelector('#build-model-btn');
    const runCalcBtn = document.querySelector('#run-calc-btn');
    const prevStepBtn = document.querySelector('#prev-step-btn');
    const nextStepBtn = document.querySelector('#next-step-btn');
    const loadsForm = document.querySelector('#loads-form');
    const editorStatus = document.querySelector('#editor-status');
    const canvas = document.querySelector('#editor-canvas');
    const modelOutput = document.querySelector('#model-output');
    const calcOutput = document.querySelector('#calc-output');
    const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]'));
    const stepPills = Array.from(document.querySelectorAll('[data-step-pill]'));

    const queryProjectId = new URLSearchParams(window.location.search).get('project');
    const activeProjectId = queryProjectId || localStorage.getItem('active-project-id');
    const activeProjectName = localStorage.getItem('active-project-name');

    /** @type {null | Record<string, any>} */
    let drawingData = null;
    /** @type {null | Record<string, any>} */
    let simplifiedModel = null;
    /** @type {null | Record<string, any>} */
    let lastResults = null;
    let currentStep = 1;

    /** @type {'column' | 'beam' | 'slabRect' | 'slabPoly'} */
    let activeTool = 'column';
    /** @type {null | { x: number; y: number }} */
    let dragStart = null;
    /** @type {Array<{ x: number; y: number }>} */
    let activePolygon = [];

    /** @type {{ version: number; createdAt: string; freeDrawing: { columns: Array<any>; beams: Array<any>; slabs: Array<any> } }} */
    let freeDrawing = {
      version: 1,
      createdAt: new Date().toISOString(),
      freeDrawing: { columns: [], beams: [], slabs: [] }
    };

    const setEditorStatus = (message, isError = false) => {
      if (!editorStatus) return;
      editorStatus.textContent = message;
      editorStatus.classList.toggle('text-desert-sienna', isError);
      editorStatus.classList.toggle('text-slate-mist', !isError);
    };

    const setStep = (step) => {
      currentStep = Math.min(3, Math.max(1, step));
      stepPanels.forEach((panel) => {
        const panelStep = Number(panel.getAttribute('data-step-panel'));
        panel.classList.toggle('hidden', panelStep !== currentStep);
      });
      stepPills.forEach((pill) => {
        const pillStep = Number(pill.getAttribute('data-step-pill'));
        const isActive = pillStep === currentStep;
        pill.classList.toggle('bg-obsidian', isActive);
        pill.classList.toggle('text-canvas-white', isActive);
      });
      if (nextStepBtn instanceof HTMLElement) {
        nextStepBtn.textContent = currentStep === 3 ? 'Finalizado' : 'Siguiente';
      }
    };

    const parseNumber = (selector, fallback, source = loadsForm) => {
      const element = source?.querySelector(selector);
      const value = Number((element instanceof HTMLInputElement && element.value) || fallback);
      return Number.isFinite(value) ? value : fallback;
    };

    const getCanvasPoint = (event) => {
      if (!(canvas instanceof HTMLCanvasElement)) return null;
      const rect = canvas.getBoundingClientRect();
      return {
        x: Math.max(0, Math.min(canvas.width, event.clientX - rect.left)),
        y: Math.max(0, Math.min(canvas.height, event.clientY - rect.top))
      };
    };

    const drawGrid = (context) => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      context.strokeStyle = '#f0f0f0';
      context.lineWidth = 1;
      for (let x = 0; x <= canvas.width; x += 40) {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, canvas.height);
        context.stroke();
      }
      for (let y = 0; y <= canvas.height; y += 40) {
        context.beginPath();
        context.moveTo(0, y);
        context.lineTo(canvas.width, y);
        context.stroke();
      }
    };

    const renderCanvas = () => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext('2d');
      if (!context) return;

      context.clearRect(0, 0, canvas.width, canvas.height);
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      drawGrid(context);

      freeDrawing.freeDrawing.slabs.forEach((slab) => {
        context.fillStyle = 'rgba(142, 142, 149, 0.25)';
        context.strokeStyle = '#8e8e95';
        context.lineWidth = 2;
        if (slab.type === 'rect') {
          const width = slab.endX - slab.startX;
          const height = slab.endY - slab.startY;
          context.fillRect(slab.startX, slab.startY, width, height);
          context.strokeRect(slab.startX, slab.startY, width, height);
        } else if (Array.isArray(slab.points) && slab.points.length > 2) {
          context.beginPath();
          slab.points.forEach((point, index) => {
            if (index === 0) context.moveTo(point.x, point.y);
            else context.lineTo(point.x, point.y);
          });
          context.closePath();
          context.fill();
          context.stroke();
        }
      });

      context.strokeStyle = '#000d10';
      context.lineWidth = 3;
      freeDrawing.freeDrawing.beams.forEach((beam) => {
        context.beginPath();
        context.moveTo(beam.startX, beam.startY);
        context.lineTo(beam.endX, beam.endY);
        context.stroke();
      });

      context.fillStyle = '#bc7155';
      freeDrawing.freeDrawing.columns.forEach((column) => {
        context.fillRect(column.startX, column.startY, column.widthPx, column.heightPx);
      });

      if (activePolygon.length > 0) {
        context.strokeStyle = '#bc7155';
        context.lineWidth = 2;
        context.beginPath();
        activePolygon.forEach((point, index) => {
          if (index === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        });
        context.stroke();
        activePolygon.forEach((point) => {
          context.beginPath();
          context.arc(point.x, point.y, 4, 0, Math.PI * 2);
          context.fill();
        });
      }
    };

    const closeActivePolygon = () => {
      if (activePolygon.length < 3) {
        setEditorStatus('Para cerrar una losa poligonal se requieren al menos 3 puntos.', true);
        return;
      }
      freeDrawing.freeDrawing.slabs.push({
        type: 'polygon',
        points: activePolygon.map((point) => ({ x: point.x, y: point.y }))
      });
      activePolygon = [];
      freeDrawing.createdAt = new Date().toISOString();
      renderCanvas();
      setEditorStatus('Losa poligonal agregada al dibujo.');
    };

    const buildFixedSimplifiedModel = () => {
      const spanXM = parseNumber('#span-x', 5);
      const spanYM = parseNumber('#span-y', 4);
      const slabThicknessM = parseNumber('#slab-thickness', 0.2);
      const deadLoadKnm2 = parseNumber('#dead-load', 1.5);
      const liveLoadKnm2 = parseNumber('#live-load', 2);

      simplifiedModel = {
        slab: {
          spanM: Math.max(spanXM, spanYM),
          thicknessM: slabThicknessM,
          deadLoadKnm2,
          liveLoadKnm2
        },
        beams: [
          { spanM: spanXM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanYM / 2 },
          { spanM: spanXM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanYM / 2 },
          { spanM: spanYM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanXM / 2 },
          { spanM: spanYM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanXM / 2 }
        ],
        columns: [
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 }
        ],
        materials: {
          fckMpa: 25,
          fyMpa: 420,
          phiFlexion: 0.9,
          phiShear: 0.75
        },
        source: 'fixed_mvp_rectangular'
      };

      if (modelOutput) {
        modelOutput.textContent = JSON.stringify(simplifiedModel, null, 2);
      }
    };

    const persistProject = async (values) => {
      if (!supabase || !activeProjectId) return { error: new Error('Proyecto no seleccionado.') };
      return supabase.from('projects').update(values).eq('id', activeProjectId);
    };

    if (!supabase) {
      window.location.href = '/login';
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else if (sessionLabel) {
        sessionLabel.textContent = `Sesion activa como ${data.session.user.email ?? 'usuario'}.`;
      }
    }

    if (!activeProjectId) {
      if (activeProjectLabel) {
        activeProjectLabel.textContent = 'No hay proyecto activo. Volve a dashboard para abrir uno.';
      }
      setEditorStatus('Selecciona un proyecto en dashboard para seguir.', true);
    } else if (activeProjectLabel) {
      activeProjectLabel.textContent = `${activeProjectName ?? 'Proyecto'} (${activeProjectId})`;
    }

    if (activeProjectId && supabase) {
      const { data: projectData } = await supabase
        .from('projects')
        .select('name, drawing_data, simplified_model, calculations, dimensioning')
        .eq('id', activeProjectId)
        .maybeSingle();

      if (projectData?.drawing_data?.freeDrawing) {
        drawingData = projectData.drawing_data;
        freeDrawing = drawingData;
      }
      if (projectData?.simplified_model) {
        simplifiedModel = projectData.simplified_model;
        if (modelOutput) modelOutput.textContent = JSON.stringify(simplifiedModel, null, 2);
      }
      if (projectData?.calculations || projectData?.dimensioning) {
        lastResults = {
          calculations: projectData.calculations,
          dimensioning: projectData.dimensioning
        };
        if (calcOutput) calcOutput.textContent = JSON.stringify(lastResults, null, 2);
      }
    }

    setStep(1);
    renderCanvas();

    drawToolSelect?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      activeTool = /** @type {'column' | 'beam' | 'slabRect' | 'slabPoly'} */ (target.value);
      if (activeTool !== 'slabPoly') activePolygon = [];
      setEditorStatus(`Herramienta activa: ${target.options[target.selectedIndex]?.text ?? target.value}.`);
      renderCanvas();
    });

    canvas?.addEventListener('pointerdown', (event) => {
      const point = getCanvasPoint(event);
      if (!point) return;
      if (activeTool === 'slabPoly') {
        activePolygon.push(point);
        renderCanvas();
        return;
      }
      dragStart = point;
    });

    canvas?.addEventListener('pointerup', (event) => {
      if (!dragStart) return;
      const endPoint = getCanvasPoint(event);
      if (!endPoint) return;

      const startX = Math.min(dragStart.x, endPoint.x);
      const startY = Math.min(dragStart.y, endPoint.y);
      const widthPx = Math.abs(endPoint.x - dragStart.x);
      const heightPx = Math.abs(endPoint.y - dragStart.y);

      if (activeTool === 'column' && widthPx > 4 && heightPx > 4) {
        const columnWidthM = parseNumber('#column-width', 0.35, document);
        const columnDepthM = parseNumber('#column-depth', 0.35, document);
        freeDrawing.freeDrawing.columns.push({
          startX,
          startY,
          widthPx,
          heightPx,
          widthM: columnWidthM,
          depthM: columnDepthM
        });
      } else if (activeTool === 'beam') {
        freeDrawing.freeDrawing.beams.push({
          startX: dragStart.x,
          startY: dragStart.y,
          endX: endPoint.x,
          endY: endPoint.y
        });
      } else if (activeTool === 'slabRect' && widthPx > 8 && heightPx > 8) {
        freeDrawing.freeDrawing.slabs.push({
          type: 'rect',
          startX,
          startY,
          endX: startX + widthPx,
          endY: startY + heightPx
        });
      }

      dragStart = null;
      freeDrawing.createdAt = new Date().toISOString();
      renderCanvas();
    });

    finishPolygonBtn?.addEventListener('click', () => {
      closeActivePolygon();
    });

    clearDrawingBtn?.addEventListener('click', () => {
      freeDrawing = {
        version: 1,
        createdAt: new Date().toISOString(),
        freeDrawing: { columns: [], beams: [], slabs: [] }
      };
      activePolygon = [];
      renderCanvas();
      setEditorStatus('Dibujo libre limpiado.');
    });

    saveDrawingBtn?.addEventListener('click', async () => {
      drawingData = {
        version: 2,
        createdAt: new Date().toISOString(),
        freeDrawing: freeDrawing.freeDrawing
      };
      setEditorStatus('Guardando drawing_data...');
      const { error } = await persistProject({
        drawing_data: drawingData,
        status: 'drawn'
      });
      if (error) {
        setEditorStatus(`Error al guardar dibujo: ${error.message}`, true);
        return;
      }
      setEditorStatus('Dibujo libre guardado correctamente.');
    });

    buildModelBtn?.addEventListener('click', async () => {
      buildFixedSimplifiedModel();
      const { error } = await persistProject({
        simplified_model: simplifiedModel,
        status: 'loads_defined'
      });
      if (error) {
        setEditorStatus(`Modelo simplificado generado, pero no se pudo guardar: ${error.message}`, true);
        return;
      }
      setEditorStatus('Modelo simplificado fijo guardado para el MVP.');
    });

    runCalcBtn?.addEventListener('click', async () => {
      if (!simplifiedModel) {
        setEditorStatus('Primero confirma el modelo simplificado en el paso 2.', true);
        return;
      }
      setEditorStatus('Ejecutando calculo y dimensionamiento...');

      const loads = calculateLoads(simplifiedModel);
      const demands = calculateDemands(simplifiedModel);
      const design = calculateDesign(simplifiedModel);

      lastResults = {
        calculations: { loads, demands },
        dimensioning: design
      };
      if (calcOutput) {
        calcOutput.textContent = JSON.stringify(lastResults, null, 2);
      }

      const { error } = await persistProject({
        calculations: lastResults.calculations,
        dimensioning: lastResults.dimensioning,
        status: 'calculated'
      });

      if (error) {
        setEditorStatus(`Calculo completado, pero no se pudo persistir: ${error.message}`, true);
        return;
      }
      setEditorStatus('Calculo y dimensionamiento persistidos en el proyecto.');
    });

    prevStepBtn?.addEventListener('click', () => {
      if (currentStep > 1) setStep(currentStep - 1);
    });

    nextStepBtn?.addEventListener('click', async () => {
      if (currentStep === 1 && activeProjectId) {
        drawingData = {
          version: 2,
          createdAt: new Date().toISOString(),
          freeDrawing: freeDrawing.freeDrawing
        };
        await persistProject({ drawing_data: drawingData, status: 'drawn' });
      }
      if (currentStep === 2 && !simplifiedModel) {
        buildFixedSimplifiedModel();
        await persistProject({ simplified_model: simplifiedModel, status: 'loads_defined' });
      }
      if (currentStep < 3) setStep(currentStep + 1);
    });

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  </script>
</Layout>
