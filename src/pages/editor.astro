---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout>
  <main class="min-h-screen bg-canvas-white px-16 py-31 text-obsidian md:px-23">
    <section class="mx-auto w-full max-w-[1100px] rounded-3xl border border-obsidian p-22">
      <div class="mb-31 flex flex-wrap items-center justify-between gap-16">
        <h1 class="text-heading leading-heading tracking-heading">Editor</h1>
        <div class="flex flex-wrap gap-11">
          <Button id="go-dashboard-btn" variant="ghost" href="/dashboard">Dashboard</Button>
          <Button id="logout-btn" variant="dark">Cerrar sesion</Button>
        </div>
      </div>
      <p id="session-label" class="max-w-3xl text-slate-mist">
        Flujo MVP por fases: dibujo libre, cargas sobre modelo fijo y calculo base.
      </p>
      <div id="active-project" class="mt-23 rounded-3xl border border-obsidian p-22">
        <h2 class="text-subheading leading-subheading tracking-subheading">Proyecto activo</h2>
        <p id="active-project-label" class="mt-11 text-slate-mist">Sin seleccionar.</p>
      </div>

      <section class="mt-23 rounded-3xl border border-obsidian p-22">
        <h2 class="text-heading-sm leading-heading-sm tracking-heading-sm">Flujo por fases</h2>
        <div class="mt-16 grid gap-11 sm:grid-cols-3">
          <div data-step-pill="1" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 1: Dibujo 2D</div>
          <div data-step-pill="2" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 2: Cargas</div>
          <div data-step-pill="3" class="rounded-full border border-obsidian px-22 pt-15 pb-16 text-center text-body-sm font-bold">Paso 3: Calculo</div>
        </div>

        <section id="step-panel-1" data-step-panel="1" class="mt-22 rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 1 - Editor de planta 2D</h3>
          <p class="mt-11 text-slate-mist">
            Herramientas separadas para columnas, vigas y losas, con seleccion, movimiento y guardado de entidades tipadas en <code>drawing_data</code>.
          </p>
          <div class="mt-16 grid gap-16 xl:grid-cols-[minmax(0,1fr)_320px]">
            <div class="grid gap-11">
              <div class="flex flex-wrap gap-11">
                <Button id="tool-select-btn" variant="ghost">Seleccionar</Button>
                <Button id="tool-column-btn" variant="ghost">Columna</Button>
                <Button id="tool-beam-btn" variant="ghost">Viga</Button>
                <Button id="tool-slab-rect-btn" variant="ghost">Losa rect</Button>
                <Button id="tool-slab-poly-btn" variant="ghost">Losa poligono</Button>
              </div>
              <div class="flex flex-wrap gap-11">
                <Button id="finish-polygon-btn" variant="ghost">Cerrar poligono</Button>
                <Button id="delete-selected-btn" variant="ghost">Eliminar seleccionado</Button>
                <Button id="clear-drawing-btn" variant="ghost">Limpiar dibujo</Button>
                <Button id="save-drawing-btn" variant="primary">Guardar dibujo</Button>
              </div>
              <div class="flex flex-wrap items-center gap-11 rounded-3xl border border-obsidian p-16">
                <label class="flex items-center gap-11">
                  <input id="snap-enabled" type="checkbox" checked />
                  <span class="font-bold">Snap a grid</span>
                </label>
                <label class="flex items-center gap-11">
                  <span class="font-bold">Grid (px)</span>
                  <input id="grid-size" type="number" min="8" max="80" step="4" value="20" class="w-28 rounded-full border border-obsidian px-16 py-8" />
                </label>
              </div>
              <canvas id="editor-canvas" class="w-full rounded-3xl border border-obsidian" width="860" height="500"></canvas>
            </div>
            <aside class="rounded-3xl border border-obsidian p-16">
              <h4 class="text-heading-sm leading-heading-sm tracking-heading-sm">Propiedades</h4>
              <p id="selection-summary" class="mt-11 text-slate-mist">Sin seleccion.</p>
              <div id="properties-panel" class="mt-11 grid gap-11">
                <label class="flex flex-col gap-8">
                  <span class="font-bold">Ancho columna (m)</span>
                  <input id="prop-column-width" type="number" min="0.1" step="0.05" value="0.35" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
                <label class="flex flex-col gap-8">
                  <span class="font-bold">Alto columna (m)</span>
                  <input id="prop-column-depth" type="number" min="0.1" step="0.05" value="0.35" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
                <label class="flex flex-col gap-8">
                  <span class="font-bold">Seccion viga (m)</span>
                  <input id="prop-beam-width" type="number" min="0.1" step="0.05" value="0.25" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
                <label class="flex flex-col gap-8">
                  <span class="font-bold">Canto viga (m)</span>
                  <input id="prop-beam-depth" type="number" min="0.1" step="0.05" value="0.5" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
                <label class="flex flex-col gap-8">
                  <span class="font-bold">Espesor losa (m)</span>
                  <input id="prop-slab-thickness" type="number" min="0.1" step="0.01" value="0.2" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
                </label>
              </div>
            </aside>
          </div>
          <p id="editor-status" class="mt-11 text-slate-mist" role="status" aria-live="polite">
            Selecciona herramienta para dibujar en planta.
          </p>
        </section>

        <section id="step-panel-2" data-step-panel="2" class="mt-22 hidden rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 2 - Cargas sobre modelo simplificado fijo</h3>
          <p class="mt-11 text-slate-mist">
            Para el MVP, el calculo ignora el dibujo libre y usa un modelo rectangular interno fijo (1 losa, 4 vigas, 4 columnas).
          </p>
          <form id="loads-form" class="mt-16 grid gap-11 sm:grid-cols-2">
            <label class="flex flex-col gap-11">
              <span class="font-bold">Luz modelo X (m)</span>
              <input id="span-x" type="number" min="2" step="0.1" value="5" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Luz modelo Y (m)</span>
              <input id="span-y" type="number" min="2" step="0.1" value="4" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Espesor losa (m)</span>
              <input id="slab-thickness" type="number" min="0.1" step="0.01" value="0.2" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11">
              <span class="font-bold">Carga viva (kN/m2)</span>
              <input id="live-load" type="number" min="0" step="0.1" value="2" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
            <label class="flex flex-col gap-11 sm:col-span-2">
              <span class="font-bold">Carga muerta adicional (kN/m2)</span>
              <input id="dead-load" type="number" min="0" step="0.1" value="1.5" class="rounded-full border border-obsidian px-22 pt-15 pb-16" />
            </label>
          </form>
          <div class="mt-16 flex flex-wrap gap-11">
            <Button id="build-model-btn" variant="primary">Confirmar modelo simplificado</Button>
          </div>
          <pre id="model-output" class="mt-16 overflow-auto rounded-3xl border border-obsidian p-16 text-body-sm text-slate-mist">Pendiente.</pre>
        </section>

        <section id="step-panel-3" data-step-panel="3" class="mt-22 hidden rounded-3xl border border-obsidian p-22">
          <h3 class="text-subheading leading-subheading tracking-subheading">Paso 3 - Calculo y resultado base</h3>
          <p class="mt-11 text-slate-mist">Ejecuta el motor de calculo sobre el modelo simplificado fijo definido en el paso 2.</p>
          <div class="mt-16 flex flex-wrap gap-11">
            <Button id="run-calc-btn" variant="dark">Ejecutar calculo</Button>
          </div>
          <pre id="calc-output" class="mt-16 overflow-auto rounded-3xl border border-obsidian p-16 text-body-sm text-slate-mist">Pendiente.</pre>
        </section>

        <div class="mt-22 flex flex-wrap items-center justify-between gap-11">
          <Button id="prev-step-btn" variant="ghost">Anterior</Button>
          <Button id="next-step-btn" variant="dark">Siguiente</Button>
        </div>
      </section>
    </section>
  </main>

  <script>
    import { supabase } from '../lib/supabase';
    import { calculateDemands, calculateDesign, calculateLoads } from '../calc';

    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');
    const activeProjectLabel = document.querySelector('#active-project-label');
    const toolSelectBtn = document.querySelector('#tool-select-btn');
    const toolColumnBtn = document.querySelector('#tool-column-btn');
    const toolBeamBtn = document.querySelector('#tool-beam-btn');
    const toolSlabRectBtn = document.querySelector('#tool-slab-rect-btn');
    const toolSlabPolyBtn = document.querySelector('#tool-slab-poly-btn');
    const finishPolygonBtn = document.querySelector('#finish-polygon-btn');
    const deleteSelectedBtn = document.querySelector('#delete-selected-btn');
    const clearDrawingBtn = document.querySelector('#clear-drawing-btn');
    const saveDrawingBtn = document.querySelector('#save-drawing-btn');
    const snapEnabledCheckbox = document.querySelector('#snap-enabled');
    const gridSizeInput = document.querySelector('#grid-size');
    const selectionSummary = document.querySelector('#selection-summary');
    const propColumnWidth = document.querySelector('#prop-column-width');
    const propColumnDepth = document.querySelector('#prop-column-depth');
    const propBeamWidth = document.querySelector('#prop-beam-width');
    const propBeamDepth = document.querySelector('#prop-beam-depth');
    const propSlabThickness = document.querySelector('#prop-slab-thickness');
    const buildModelBtn = document.querySelector('#build-model-btn');
    const runCalcBtn = document.querySelector('#run-calc-btn');
    const prevStepBtn = document.querySelector('#prev-step-btn');
    const nextStepBtn = document.querySelector('#next-step-btn');
    const loadsForm = document.querySelector('#loads-form');
    const editorStatus = document.querySelector('#editor-status');
    const canvas = document.querySelector('#editor-canvas');
    const modelOutput = document.querySelector('#model-output');
    const calcOutput = document.querySelector('#calc-output');
    const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]'));
    const stepPills = Array.from(document.querySelectorAll('[data-step-pill]'));

    const queryProjectId = new URLSearchParams(window.location.search).get('project');
    const activeProjectId = queryProjectId || localStorage.getItem('active-project-id');
    const activeProjectName = localStorage.getItem('active-project-name');

    /** @type {null | Record<string, any>} */
    let drawingData = null;
    /** @type {null | Record<string, any>} */
    let simplifiedModel = null;
    /** @type {null | Record<string, any>} */
    let lastResults = null;
    let currentStep = 1;

    /**
     * @typedef {'select' | 'column' | 'beam' | 'slabRect' | 'slabPoly'} Tool
     * @typedef {{ id: string; type: 'column'; x: number; y: number; width: number; height: number; props: { widthM: number; depthM: number } }} ColumnEntity
     * @typedef {{ id: string; type: 'beam'; x1: number; y1: number; x2: number; y2: number; props: { widthM: number; depthM: number } }} BeamEntity
     * @typedef {{ id: string; type: 'slab'; shape: 'rect'; x: number; y: number; width: number; height: number; props: { thicknessM: number } } | { id: string; type: 'slab'; shape: 'polygon'; points: Array<{ x: number; y: number }>; props: { thicknessM: number } }} SlabEntity
     * @typedef {{ version: number; createdAt: string; grid: { size: number; snapEnabled: boolean }; entities: { columns: ColumnEntity[]; beams: BeamEntity[]; slabs: SlabEntity[] }; freeDrawing: { columns: Array<any>; beams: Array<any>; slabs: Array<any> } }} DrawingState
     */

    /** @type {Tool} */
    let activeTool = 'select';
    /** @type {null | { x: number; y: number }} */
    let dragStart = null;
    /** @type {Array<{ x: number; y: number }>} */
    let activePolygon = [];
    /** @type {null | { type: 'column' | 'beam' | 'slab'; id: string }} */
    let selectedEntityRef = null;
    /** @type {null | { startPointer: { x: number; y: number }; startEntity: any }} */
    let dragSelectionState = null;

    /** @type {DrawingState} */
    let drawingState = {
      version: 3,
      createdAt: new Date().toISOString(),
      grid: { size: 20, snapEnabled: true },
      entities: { columns: [], beams: [], slabs: [] },
      freeDrawing: { columns: [], beams: [], slabs: [] }
    };

    const setEditorStatus = (message, isError = false) => {
      if (!editorStatus) return;
      editorStatus.textContent = message;
      editorStatus.classList.toggle('text-desert-sienna', isError);
      editorStatus.classList.toggle('text-slate-mist', !isError);
    };

    const setStep = (step) => {
      currentStep = Math.min(3, Math.max(1, step));
      stepPanels.forEach((panel) => {
        const panelStep = Number(panel.getAttribute('data-step-panel'));
        panel.classList.toggle('hidden', panelStep !== currentStep);
      });
      stepPills.forEach((pill) => {
        const pillStep = Number(pill.getAttribute('data-step-pill'));
        const isActive = pillStep === currentStep;
        pill.classList.toggle('bg-obsidian', isActive);
        pill.classList.toggle('text-canvas-white', isActive);
      });
      if (nextStepBtn instanceof HTMLElement) {
        nextStepBtn.textContent = currentStep === 3 ? 'Finalizado' : 'Siguiente';
      }
    };

    const parseNumber = (selector, fallback, source = loadsForm) => {
      const element = source?.querySelector(selector);
      const value = Number((element instanceof HTMLInputElement && element.value) || fallback);
      return Number.isFinite(value) ? value : fallback;
    };

    const toFixedNumber = (value, digits = 3) => Number(value.toFixed(digits));

    const getCanvasPoint = (event) => {
      if (!(canvas instanceof HTMLCanvasElement)) return null;
      const rect = canvas.getBoundingClientRect();
      return {
        x: Math.max(0, Math.min(canvas.width, event.clientX - rect.left)),
        y: Math.max(0, Math.min(canvas.height, event.clientY - rect.top))
      };
    };

    const normalizeRect = (x1, y1, x2, y2) => ({
      x: Math.min(x1, x2),
      y: Math.min(y1, y2),
      width: Math.abs(x2 - x1),
      height: Math.abs(y2 - y1)
    });

    const nextId = (prefix) => `${prefix}_${Math.random().toString(36).slice(2, 10)}`;

    const snapPoint = (point) => {
      const grid = Math.max(8, Number(drawingState.grid.size) || 20);
      if (!drawingState.grid.snapEnabled) return point;
      return {
        x: Math.round(point.x / grid) * grid,
        y: Math.round(point.y / grid) * grid
      };
    };

    const drawGrid = (context) => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const grid = Math.max(8, Number(drawingState.grid.size) || 20);
      context.strokeStyle = '#f0f0f0';
      context.lineWidth = 1;
      for (let x = 0; x <= canvas.width; x += grid) {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, canvas.height);
        context.stroke();
      }
      for (let y = 0; y <= canvas.height; y += grid) {
        context.beginPath();
        context.moveTo(0, y);
        context.lineTo(canvas.width, y);
        context.stroke();
      }
    };

    const toLegacyFreeDrawing = () => {
      const columns = drawingState.entities.columns.map((column) => ({
        startX: column.x,
        startY: column.y,
        widthPx: column.width,
        heightPx: column.height,
        widthM: column.props.widthM,
        depthM: column.props.depthM
      }));
      const beams = drawingState.entities.beams.map((beam) => ({
        startX: beam.x1,
        startY: beam.y1,
        endX: beam.x2,
        endY: beam.y2,
        widthM: beam.props.widthM,
        depthM: beam.props.depthM
      }));
      const slabs = drawingState.entities.slabs.map((slab) =>
        slab.shape === 'rect'
          ? {
              type: 'rect',
              startX: slab.x,
              startY: slab.y,
              endX: slab.x + slab.width,
              endY: slab.y + slab.height,
              thicknessM: slab.props.thicknessM
            }
          : {
              type: 'polygon',
              points: slab.points.map((point) => ({ x: point.x, y: point.y })),
              thicknessM: slab.props.thicknessM
            }
      );
      return { columns, beams, slabs };
    };

    const refreshDerivedDrawing = () => {
      drawingState.createdAt = new Date().toISOString();
      drawingState.freeDrawing = toLegacyFreeDrawing();
    };

    const pointInPolygon = (point, polygon) => {
      let inside = false;
      for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
        const xi = polygon[i].x;
        const yi = polygon[i].y;
        const xj = polygon[j].x;
        const yj = polygon[j].y;
        const intersect = yi > point.y !== yj > point.y && point.x < ((xj - xi) * (point.y - yi)) / (yj - yi + 0.000001) + xi;
        if (intersect) inside = !inside;
      }
      return inside;
    };

    const distancePointToSegment = (point, a, b) => {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      if (dx === 0 && dy === 0) return Math.hypot(point.x - a.x, point.y - a.y);
      const t = Math.max(0, Math.min(1, ((point.x - a.x) * dx + (point.y - a.y) * dy) / (dx * dx + dy * dy)));
      const px = a.x + t * dx;
      const py = a.y + t * dy;
      return Math.hypot(point.x - px, point.y - py);
    };

    const findEntityAtPoint = (point) => {
      for (let i = drawingState.entities.columns.length - 1; i >= 0; i -= 1) {
        const column = drawingState.entities.columns[i];
        if (point.x >= column.x && point.x <= column.x + column.width && point.y >= column.y && point.y <= column.y + column.height) {
          return { type: 'column', id: column.id };
        }
      }
      for (let i = drawingState.entities.beams.length - 1; i >= 0; i -= 1) {
        const beam = drawingState.entities.beams[i];
        const distance = distancePointToSegment(point, { x: beam.x1, y: beam.y1 }, { x: beam.x2, y: beam.y2 });
        if (distance < 8) return { type: 'beam', id: beam.id };
      }
      for (let i = drawingState.entities.slabs.length - 1; i >= 0; i -= 1) {
        const slab = drawingState.entities.slabs[i];
        if (slab.shape === 'rect') {
          if (point.x >= slab.x && point.x <= slab.x + slab.width && point.y >= slab.y && point.y <= slab.y + slab.height) {
            return { type: 'slab', id: slab.id };
          }
        } else if (pointInPolygon(point, slab.points)) {
          return { type: 'slab', id: slab.id };
        }
      }
      return null;
    };

    const getSelectedEntity = () => {
      if (!selectedEntityRef) return null;
      const listKey = `${selectedEntityRef.type}s`;
      const list = drawingState.entities[listKey];
      if (!Array.isArray(list)) return null;
      return list.find((item) => item.id === selectedEntityRef.id) ?? null;
    };

    const updatePropertiesPanel = () => {
      const selected = getSelectedEntity();
      if (!selectionSummary) return;
      if (!selected) {
        selectionSummary.textContent = 'Sin seleccion.';
        return;
      }
      selectionSummary.textContent = `${selected.type.toUpperCase()} ${selected.id.slice(-4)}`;
      if (selected.type === 'column') {
        if (propColumnWidth instanceof HTMLInputElement) propColumnWidth.value = String(selected.props.widthM);
        if (propColumnDepth instanceof HTMLInputElement) propColumnDepth.value = String(selected.props.depthM);
      }
      if (selected.type === 'beam') {
        if (propBeamWidth instanceof HTMLInputElement) propBeamWidth.value = String(selected.props.widthM);
        if (propBeamDepth instanceof HTMLInputElement) propBeamDepth.value = String(selected.props.depthM);
      }
      if (selected.type === 'slab' && propSlabThickness instanceof HTMLInputElement) {
        propSlabThickness.value = String(selected.props.thicknessM);
      }
    };

    const renderCanvas = () => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext('2d');
      if (!context) return;

      context.clearRect(0, 0, canvas.width, canvas.height);
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      drawGrid(context);

      drawingState.entities.slabs.forEach((slab) => {
        context.fillStyle = 'rgba(142, 142, 149, 0.25)';
        context.strokeStyle = '#8e8e95';
        context.lineWidth = selectedEntityRef?.id === slab.id ? 3 : 2;
        if (slab.shape === 'rect') {
          context.fillRect(slab.x, slab.y, slab.width, slab.height);
          context.strokeRect(slab.x, slab.y, slab.width, slab.height);
        } else if (Array.isArray(slab.points) && slab.points.length > 2) {
          context.beginPath();
          slab.points.forEach((point, index) => {
            if (index === 0) context.moveTo(point.x, point.y);
            else context.lineTo(point.x, point.y);
          });
          context.closePath();
          context.fill();
          context.stroke();
        }
      });

      context.strokeStyle = '#000d10';
      context.lineWidth = 3;
      drawingState.entities.beams.forEach((beam) => {
        context.lineWidth = selectedEntityRef?.id === beam.id ? 4 : 3;
        context.beginPath();
        context.moveTo(beam.x1, beam.y1);
        context.lineTo(beam.x2, beam.y2);
        context.stroke();
      });

      context.fillStyle = '#bc7155';
      drawingState.entities.columns.forEach((column) => {
        if (selectedEntityRef?.id === column.id) {
          context.fillStyle = '#000d10';
        } else {
          context.fillStyle = '#bc7155';
        }
        context.fillRect(column.x, column.y, column.width, column.height);
      });

      if (activePolygon.length > 0) {
        context.strokeStyle = '#bc7155';
        context.lineWidth = 2;
        context.beginPath();
        activePolygon.forEach((point, index) => {
          if (index === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        });
        context.stroke();
        activePolygon.forEach((point) => {
          context.beginPath();
          context.arc(point.x, point.y, 4, 0, Math.PI * 2);
          context.fill();
        });
      }
    };

    const closeActivePolygon = () => {
      if (activePolygon.length < 3) {
        setEditorStatus('Para cerrar una losa poligonal se requieren al menos 3 puntos.', true);
        return;
      }
      drawingState.entities.slabs.push({
        id: nextId('slab'),
        type: 'slab',
        shape: 'polygon',
        points: activePolygon.map((point) => ({ x: point.x, y: point.y })),
        props: {
          thicknessM: parseNumber('#prop-slab-thickness', 0.2, document)
        }
      });
      activePolygon = [];
      refreshDerivedDrawing();
      renderCanvas();
      setEditorStatus('Losa poligonal agregada al dibujo.');
    };

    const setActiveTool = (tool) => {
      activeTool = tool;
      if (tool !== 'slabPoly') activePolygon = [];
      setEditorStatus(`Herramienta activa: ${tool}.`);
      const entries = [
        [toolSelectBtn, 'select'],
        [toolColumnBtn, 'column'],
        [toolBeamBtn, 'beam'],
        [toolSlabRectBtn, 'slabRect'],
        [toolSlabPolyBtn, 'slabPoly']
      ];
      entries.forEach(([element, toolName]) => {
        if (!(element instanceof HTMLElement)) return;
        const isActive = toolName === tool;
        element.classList.toggle('bg-obsidian', isActive);
        element.classList.toggle('text-canvas-white', isActive);
      });
      renderCanvas();
    };

    const deleteSelected = () => {
      if (!selectedEntityRef) {
        setEditorStatus('No hay elemento seleccionado para eliminar.', true);
        return;
      }
      const key = `${selectedEntityRef.type}s`;
      drawingState.entities[key] = drawingState.entities[key].filter((item) => item.id !== selectedEntityRef.id);
      selectedEntityRef = null;
      refreshDerivedDrawing();
      updatePropertiesPanel();
      renderCanvas();
      setEditorStatus('Elemento eliminado.');
    };

    const applyPropertyInputsToSelection = () => {
      const selected = getSelectedEntity();
      if (!selected) return;
      if (selected.type === 'column') {
        selected.props.widthM = parseNumber('#prop-column-width', selected.props.widthM, document);
        selected.props.depthM = parseNumber('#prop-column-depth', selected.props.depthM, document);
      } else if (selected.type === 'beam') {
        selected.props.widthM = parseNumber('#prop-beam-width', selected.props.widthM, document);
        selected.props.depthM = parseNumber('#prop-beam-depth', selected.props.depthM, document);
      } else if (selected.type === 'slab') {
        selected.props.thicknessM = parseNumber('#prop-slab-thickness', selected.props.thicknessM, document);
      }
      refreshDerivedDrawing();
      renderCanvas();
    };

    const buildFixedSimplifiedModel = () => {
      const spanXM = parseNumber('#span-x', 5);
      const spanYM = parseNumber('#span-y', 4);
      const slabThicknessM = parseNumber('#slab-thickness', 0.2);
      const deadLoadKnm2 = parseNumber('#dead-load', 1.5);
      const liveLoadKnm2 = parseNumber('#live-load', 2);

      simplifiedModel = {
        slab: {
          spanM: Math.max(spanXM, spanYM),
          thicknessM: slabThicknessM,
          deadLoadKnm2,
          liveLoadKnm2
        },
        beams: [
          { spanM: spanXM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanYM / 2 },
          { spanM: spanXM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanYM / 2 },
          { spanM: spanYM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanXM / 2 },
          { spanM: spanYM, widthM: 0.25, depthM: 0.5, tributaryWidthM: spanXM / 2 }
        ],
        columns: [
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 },
          { widthM: 0.35, depthM: 0.35, floors: 2 }
        ],
        materials: {
          fckMpa: 25,
          fyMpa: 420,
          phiFlexion: 0.9,
          phiShear: 0.75
        },
        source: 'fixed_mvp_rectangular'
      };

      if (modelOutput) {
        modelOutput.textContent = JSON.stringify(simplifiedModel, null, 2);
      }
    };

    const persistProject = async (values) => {
      if (!supabase || !activeProjectId) return { error: new Error('Proyecto no seleccionado.') };
      return supabase.from('projects').update(values).eq('id', activeProjectId);
    };

    if (!supabase) {
      window.location.href = '/login';
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else if (sessionLabel) {
        sessionLabel.textContent = `Sesion activa como ${data.session.user.email ?? 'usuario'}.`;
      }
    }

    if (!activeProjectId) {
      if (activeProjectLabel) {
        activeProjectLabel.textContent = 'No hay proyecto activo. Volve a dashboard para abrir uno.';
      }
      setEditorStatus('Selecciona un proyecto en dashboard para seguir.', true);
    } else if (activeProjectLabel) {
      activeProjectLabel.textContent = `${activeProjectName ?? 'Proyecto'} (${activeProjectId})`;
    }

    if (activeProjectId && supabase) {
      const { data: projectData } = await supabase
        .from('projects')
        .select('name, drawing_data, simplified_model, calculations, dimensioning')
        .eq('id', activeProjectId)
        .maybeSingle();

      if (projectData?.drawing_data) {
        drawingData = projectData.drawing_data;
        const source = projectData.drawing_data;
        const legacy = source.freeDrawing ?? { columns: [], beams: [], slabs: [] };
        const entities = source.entities ?? {
          columns: (legacy.columns ?? []).map((column) => ({
            id: nextId('col'),
            type: 'column',
            x: column.startX ?? 0,
            y: column.startY ?? 0,
            width: column.widthPx ?? 20,
            height: column.heightPx ?? 20,
            props: {
              widthM: column.widthM ?? 0.35,
              depthM: column.depthM ?? 0.35
            }
          })),
          beams: (legacy.beams ?? []).map((beam) => ({
            id: nextId('beam'),
            type: 'beam',
            x1: beam.startX ?? 0,
            y1: beam.startY ?? 0,
            x2: beam.endX ?? 0,
            y2: beam.endY ?? 0,
            props: {
              widthM: beam.widthM ?? 0.25,
              depthM: beam.depthM ?? 0.5
            }
          })),
          slabs: (legacy.slabs ?? []).map((slab) =>
            slab.type === 'rect'
              ? {
                  id: nextId('slab'),
                  type: 'slab',
                  shape: 'rect',
                  x: slab.startX ?? 0,
                  y: slab.startY ?? 0,
                  width: (slab.endX ?? 0) - (slab.startX ?? 0),
                  height: (slab.endY ?? 0) - (slab.startY ?? 0),
                  props: { thicknessM: slab.thicknessM ?? 0.2 }
                }
              : {
                  id: nextId('slab'),
                  type: 'slab',
                  shape: 'polygon',
                  points: slab.points ?? [],
                  props: { thicknessM: slab.thicknessM ?? 0.2 }
                }
          )
        };
        drawingState = {
          version: source.version ?? 3,
          createdAt: source.createdAt ?? new Date().toISOString(),
          grid: {
            size: source.grid?.size ?? 20,
            snapEnabled: source.grid?.snapEnabled ?? true
          },
          entities,
          freeDrawing: legacy
        };
      }
      if (projectData?.simplified_model) {
        simplifiedModel = projectData.simplified_model;
        if (modelOutput) modelOutput.textContent = JSON.stringify(simplifiedModel, null, 2);
      }
      if (projectData?.calculations || projectData?.dimensioning) {
        lastResults = {
          calculations: projectData.calculations,
          dimensioning: projectData.dimensioning
        };
        if (calcOutput) calcOutput.textContent = JSON.stringify(lastResults, null, 2);
      }
    }

    if (gridSizeInput instanceof HTMLInputElement) gridSizeInput.value = String(drawingState.grid.size);
    if (snapEnabledCheckbox instanceof HTMLInputElement) snapEnabledCheckbox.checked = drawingState.grid.snapEnabled;

    setStep(1);
    setActiveTool('select');
    updatePropertiesPanel();
    renderCanvas();

    toolSelectBtn?.addEventListener('click', () => setActiveTool('select'));
    toolColumnBtn?.addEventListener('click', () => setActiveTool('column'));
    toolBeamBtn?.addEventListener('click', () => setActiveTool('beam'));
    toolSlabRectBtn?.addEventListener('click', () => setActiveTool('slabRect'));
    toolSlabPolyBtn?.addEventListener('click', () => setActiveTool('slabPoly'));

    canvas?.addEventListener('pointerdown', (event) => {
      const pointer = getCanvasPoint(event);
      if (!pointer) return;
      const point = snapPoint(pointer);
      if (activeTool === 'select') {
        selectedEntityRef = findEntityAtPoint(point);
        updatePropertiesPanel();
        if (selectedEntityRef) {
          const selected = getSelectedEntity();
          dragSelectionState = {
            startPointer: point,
            startEntity: selected ? structuredClone(selected) : null
          };
          setEditorStatus(`Seleccionado ${selectedEntityRef.type}. Arrastra para mover.`);
        } else {
          dragSelectionState = null;
          setEditorStatus('Sin seleccion en ese punto.');
        }
        renderCanvas();
        return;
      }
      dragSelectionState = null;
      if (!point) return;
      if (activeTool === 'slabPoly') {
        activePolygon.push(point);
        renderCanvas();
        return;
      }
      dragStart = point;
    });

    canvas?.addEventListener('pointerup', (event) => {
      if (!dragStart) return;
      const endPointRaw = getCanvasPoint(event);
      if (!endPointRaw) return;
      const endPoint = snapPoint(endPointRaw);

      if (activeTool === 'select' && selectedEntityRef && dragSelectionState?.startEntity) {
        dragStart = null;
        dragSelectionState = null;
        return;
      }

      const rect = normalizeRect(dragStart.x, dragStart.y, endPoint.x, endPoint.y);

      if (activeTool === 'column' && rect.width > 4 && rect.height > 4) {
        drawingState.entities.columns.push({
          id: nextId('col'),
          type: 'column',
          x: rect.x,
          y: rect.y,
          width: rect.width,
          height: rect.height,
          props: {
            widthM: parseNumber('#prop-column-width', 0.35, document),
            depthM: parseNumber('#prop-column-depth', 0.35, document)
          }
        });
      } else if (activeTool === 'beam') {
        drawingState.entities.beams.push({
          id: nextId('beam'),
          type: 'beam',
          x1: dragStart.x,
          y1: dragStart.y,
          x2: endPoint.x,
          y2: endPoint.y,
          props: {
            widthM: parseNumber('#prop-beam-width', 0.25, document),
            depthM: parseNumber('#prop-beam-depth', 0.5, document)
          }
        });
      } else if (activeTool === 'slabRect' && rect.width > 8 && rect.height > 8) {
        drawingState.entities.slabs.push({
          id: nextId('slab'),
          type: 'slab',
          shape: 'rect',
          x: rect.x,
          y: rect.y,
          width: rect.width,
          height: rect.height,
          props: {
            thicknessM: parseNumber('#prop-slab-thickness', 0.2, document)
          }
        });
      }

      dragStart = null;
      dragSelectionState = null;
      refreshDerivedDrawing();
      renderCanvas();
    });

    canvas?.addEventListener('pointermove', (event) => {
      if (activeTool !== 'select' || !selectedEntityRef || !dragSelectionState?.startEntity) return;
      const currentRaw = getCanvasPoint(event);
      if (!currentRaw) return;
      const current = snapPoint(currentRaw);
      const deltaX = current.x - dragSelectionState.startPointer.x;
      const deltaY = current.y - dragSelectionState.startPointer.y;
      const selected = getSelectedEntity();
      if (!selected) return;

      if (selected.type === 'column') {
        selected.x = toFixedNumber(dragSelectionState.startEntity.x + deltaX);
        selected.y = toFixedNumber(dragSelectionState.startEntity.y + deltaY);
      } else if (selected.type === 'beam') {
        selected.x1 = toFixedNumber(dragSelectionState.startEntity.x1 + deltaX);
        selected.y1 = toFixedNumber(dragSelectionState.startEntity.y1 + deltaY);
        selected.x2 = toFixedNumber(dragSelectionState.startEntity.x2 + deltaX);
        selected.y2 = toFixedNumber(dragSelectionState.startEntity.y2 + deltaY);
      } else if (selected.type === 'slab') {
        if (selected.shape === 'rect') {
          selected.x = toFixedNumber(dragSelectionState.startEntity.x + deltaX);
          selected.y = toFixedNumber(dragSelectionState.startEntity.y + deltaY);
        } else {
          selected.points = dragSelectionState.startEntity.points.map((point) => ({
            x: toFixedNumber(point.x + deltaX),
            y: toFixedNumber(point.y + deltaY)
          }));
        }
      }
      refreshDerivedDrawing();
      renderCanvas();
    });

    finishPolygonBtn?.addEventListener('click', () => {
      closeActivePolygon();
    });

    deleteSelectedBtn?.addEventListener('click', () => {
      deleteSelected();
    });

    clearDrawingBtn?.addEventListener('click', () => {
      drawingState = {
        version: 3,
        createdAt: new Date().toISOString(),
        grid: drawingState.grid,
        entities: { columns: [], beams: [], slabs: [] },
        freeDrawing: { columns: [], beams: [], slabs: [] }
      };
      activePolygon = [];
      selectedEntityRef = null;
      updatePropertiesPanel();
      renderCanvas();
      setEditorStatus('Dibujo libre limpiado.');
    });

    snapEnabledCheckbox?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      drawingState.grid.snapEnabled = target.checked;
      renderCanvas();
    });

    gridSizeInput?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      drawingState.grid.size = Math.max(8, Math.min(80, Number(target.value) || 20));
      target.value = String(drawingState.grid.size);
      renderCanvas();
    });

    [propColumnWidth, propColumnDepth, propBeamWidth, propBeamDepth, propSlabThickness].forEach((input) => {
      input?.addEventListener('change', () => {
        applyPropertyInputsToSelection();
      });
    });

    saveDrawingBtn?.addEventListener('click', async () => {
      refreshDerivedDrawing();
      drawingData = {
        version: 3,
        createdAt: new Date().toISOString(),
        grid: drawingState.grid,
        entities: drawingState.entities,
        freeDrawing: drawingState.freeDrawing
      };
      setEditorStatus('Guardando drawing_data...');
      const { error } = await persistProject({
        drawing_data: drawingData,
        status: 'drawn'
      });
      if (error) {
        setEditorStatus(`Error al guardar dibujo: ${error.message}`, true);
        return;
      }
      setEditorStatus('Dibujo 2D guardado correctamente.');
    });

    buildModelBtn?.addEventListener('click', async () => {
      buildFixedSimplifiedModel();
      const { error } = await persistProject({
        simplified_model: simplifiedModel,
        status: 'loads_defined'
      });
      if (error) {
        setEditorStatus(`Modelo simplificado generado, pero no se pudo guardar: ${error.message}`, true);
        return;
      }
      setEditorStatus('Modelo simplificado fijo guardado para el MVP.');
    });

    runCalcBtn?.addEventListener('click', async () => {
      if (!simplifiedModel) {
        setEditorStatus('Primero confirma el modelo simplificado en el paso 2.', true);
        return;
      }
      setEditorStatus('Ejecutando calculo y dimensionamiento...');

      const loads = calculateLoads(simplifiedModel);
      const demands = calculateDemands(simplifiedModel);
      const design = calculateDesign(simplifiedModel);

      lastResults = {
        calculations: { loads, demands },
        dimensioning: design
      };
      if (calcOutput) {
        calcOutput.textContent = JSON.stringify(lastResults, null, 2);
      }

      const { error } = await persistProject({
        calculations: lastResults.calculations,
        dimensioning: lastResults.dimensioning,
        status: 'calculated'
      });

      if (error) {
        setEditorStatus(`Calculo completado, pero no se pudo persistir: ${error.message}`, true);
        return;
      }
      setEditorStatus('Calculo y dimensionamiento persistidos en el proyecto.');
    });

    prevStepBtn?.addEventListener('click', () => {
      if (currentStep > 1) setStep(currentStep - 1);
    });

    nextStepBtn?.addEventListener('click', async () => {
      if (currentStep === 1 && activeProjectId) {
        refreshDerivedDrawing();
        drawingData = {
          version: 3,
          createdAt: new Date().toISOString(),
          grid: drawingState.grid,
          entities: drawingState.entities,
          freeDrawing: drawingState.freeDrawing
        };
        await persistProject({ drawing_data: drawingData, status: 'drawn' });
      }
      if (currentStep === 2 && !simplifiedModel) {
        buildFixedSimplifiedModel();
        await persistProject({ simplified_model: simplifiedModel, status: 'loads_defined' });
      }
      if (currentStep < 3) setStep(currentStep + 1);
    });

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Delete' || event.key === 'Backspace') {
        const target = event.target;
        const isInput = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
        if (!isInput) {
          event.preventDefault();
          deleteSelected();
        }
      }
    });
  </script>
</Layout>
