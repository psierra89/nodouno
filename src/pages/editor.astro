---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout>
  <main class="landing">
    <section class="page-shell">
      <div class="page-head">
        <h1 class="page-title">Editor</h1>
        <Button id="logout-btn" variant="dark">Cerrar sesion</Button>
      </div>
      <p id="session-label" class="page-subtitle">
        Base lista para dibujar geometria, correr calculos y dimensionar.
      </p>
    </section>
  </main>
  <script>
    import { supabase } from '../lib/supabase';
    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');

    if (!supabase) {
      window.location.href = '/login';
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else if (sessionLabel) {
        sessionLabel.textContent = `Sesion activa como ${data.session.user.email ?? 'usuario'}.`;
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  </script>
</Layout>
