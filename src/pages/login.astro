---
import Layout from '../layouts/Layout.astro';
import logoTr from '../../assets/logos/Tr-Fondo-Blanco.png';
---
<Layout>
  <main class="landing minimal-center">
    <section class="minimal-box login-box">
      <img src={logoTr.src} alt="Nodouno" class="brand-logo-tr" />
      <h1 class="minimal-title">Iniciar sesion</h1>
      <p id="login-status" class="minimal-copy">Ingresa tu usuario y contrasena para continuar.</p>

      <form id="login-form" class="login-form">
        <div class="login-row">
          <input id="login-email" type="email" placeholder="tu@email.com" class="auth-input" />
        </div>

        <div class="login-row">
          <input id="login-password" type="password" placeholder="Contrasena" class="auth-input" />
        </div>

        <div class="login-row center">
          <button id="login-submit" class="btn-base btn-primary" type="submit">Entrar</button>
        </div>
      </form>

      <p class="register-inline">
        No tienes cuenta?
        <a id="register-link" href="#">Crea una aqui.</a>
      </p>

      <a href="/" class="back-link">&larr; Volver</a>
    </section>
  </main>

  <script>
    import { supabase } from '../lib/supabase';

    const statusEl = document.querySelector('#login-status');
    const loginForm = document.querySelector('#login-form');
    const emailEl = document.querySelector('#login-email');
    const passwordEl = document.querySelector('#login-password');
    const submitBtn = document.querySelector('#login-submit');
    const registerLink = document.querySelector('#register-link');

    const setStatus = (message) => {
      if (statusEl) statusEl.textContent = message;
    };

    if (!supabase) {
      setStatus('Configuracion incompleta para iniciar sesion.');
      submitBtn?.setAttribute('disabled', 'true');
    } else {
      const { data } = await supabase.auth.getSession();
      if (data.session) {
        window.location.href = '/dashboard';
      }
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!supabase) return;
      const email = emailEl?.value?.trim();
      const password = passwordEl?.value ?? '';
      if (!email || !password) {
        setStatus('Completa email y contrasena.');
        return;
      }

      setStatus('Validando credenciales...');
      const { error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        setStatus(`Error: ${error.message}`);
        return;
      }
      window.location.href = '/dashboard';
    });

    registerLink?.addEventListener('click', (event) => {
      event.preventDefault();
      setStatus('Registro no habilitado por ahora.');
    });
  </script>
</Layout>
