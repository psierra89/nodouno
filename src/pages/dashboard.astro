---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout>
  <main class="landing minimal-center">
    <section class="page-shell">
      <div class="page-head centered">
        <h1 class="page-title">Dashboard</h1>
        <Button id="logout-btn" variant="dark">Cerrar sesion</Button>
      </div>
      <p id="session-label" class="page-subtitle centered">Comprobando sesion...</p>
      <section class="projects-wrap">
        <h2 class="projects-title">Tus proyectos</h2>
        <div id="projects-list" class="projects-list">
          <p class="empty-projects">Cargando proyectos...</p>
        </div>
      </section>
    </section>
  </main>
  <script>
    import { supabase } from '../lib/supabase';
    const sessionLabel = document.querySelector('#session-label');
    const logoutBtn = document.querySelector('#logout-btn');
    const projectsList = document.querySelector('#projects-list');

    if (!supabase) {
      window.location.href = '/login';
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else if (sessionLabel) {
        sessionLabel.textContent = `Sesion activa como ${data.session.user.email ?? 'usuario'}.`;

        const { data: projects, error } = await supabase
          .from('projects')
          .select('id, name, status, created_at')
          .order('created_at', { ascending: false });

        if (error) {
          projectsList.innerHTML = '<p class="empty-projects">No se pudieron cargar tus proyectos.</p>';
        } else if (!projects || projects.length === 0) {
          projectsList.innerHTML = '<p class="empty-projects">Aun no tienes proyectos creados.</p>';
        } else {
          projectsList.innerHTML = '';
          projects.forEach((project) => {
            const card = document.createElement('article');
            card.className = 'project-card';

            const title = document.createElement('h3');
            title.textContent = project.name || 'Proyecto sin titulo';

            const status = document.createElement('p');
            status.textContent = `Estado: ${project.status}`;

            card.appendChild(title);
            card.appendChild(status);
            projectsList.appendChild(card);
          });
        }
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  </script>
</Layout>
